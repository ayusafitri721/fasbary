---
import "../styles/global.css";
import logo from "../assets/LOGO_NAS.jpg";
import BackToTop from "../components/BackToTop.astro";
import PWAInstall from "../components/PWAInstall.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="theme-color" content="#0037b0" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-title" content="Fasbary" />
        <meta name="apple-mobile-web-app-status-bar-style" content="default" />
        <meta name="description" content="Portfolio of Namry Ayu Safitri - Full-Stack Developer Enthusiast" />
        <link rel="icon" type="image/jpeg" href={logo.src} />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/manifest.webmanifest" />
        <meta name="generator" content={Astro.generator} />

        <!-- Google Fonts: Plus Jakarta Sans -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
            rel="stylesheet"
        />

        <title>{title}</title>
    </head>
    <body
        class="bg-background text-on-background relative overflow-x-hidden min-h-screen"
    >
        <!-- Background blueprint technical grid -->
        <div class="fixed inset-0 blueprint-grid -z-10 pointer-events-none">
        </div>

        <slot />

        <!-- Back to top floating button -->
        <BackToTop />

        <PWAInstall />

        <script is:inline>
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', () => {
                    navigator.serviceWorker.register('/sw.js').catch((err) => {
                        console.warn('SW registration failed:', err);
                    });
                });
            }
        </script>
    </body>
</html>
