---
import { Icon } from "astro-icon/components";
---

<header
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-transparent bg-surface/70 backdrop-blur-md"
    id="main-header"
>
    <div
        class="max-w-[1280px] mx-auto px-6 desktop:px-16 py-4 flex items-center justify-between"
    >
        <!-- Logo -->
        <a
            href="#home"
            class="text-xl font-bold tracking-tight text-on-background flex items-center gap-1 hover:text-primary transition-colors"
        >
            <span class="italic font-extrabold text-2xl tracking-tighter"
                >Namry Ayu Safitri</span
            >
        </a>

        <!-- Navigation Menu (Desktop) -->
        <nav class="hidden md:flex items-center gap-8 py-2 px-6">
            <a
                href="#home"
                class="nav-link text-sm font-semibold text-on-background hover:text-primary transition-colors"
                data-nav="home"
                >Home</a
            >
            <a
                href="#about"
                class="nav-link text-sm font-semibold text-on-background hover:text-primary transition-colors"
                data-nav="about"
                >About Me</a
            >
            <a
                href="#skills"
                class="nav-link text-sm font-semibold text-on-background hover:text-primary transition-colors"
                data-nav="skills"
                >Skills</a
            >
            <a
                href="#experience"
                class="nav-link text-sm font-semibold text-on-background hover:text-primary transition-colors"
                data-nav="experience"
                >Experience</a
            >
            <a
                href="#projects"
                class="nav-link text-sm font-semibold text-on-background hover:text-primary transition-colors"
                data-nav="projects"
                >Projects</a
            >
            <a
                href="#contact"
                class="nav-link text-sm font-semibold text-on-background hover:text-primary transition-colors"
                data-nav="contact"
                >Contact</a
            >
        </nav>

        <!-- CTA Button -->
        <div class="flex items-center gap-4">
            <a
                href="#contact"
                class="hidden sm:inline-flex items-center justify-center bg-primary text-white text-sm font-medium px-6 py-2.5 rounded-full hover:bg-primary-container transition-all hover:scale-105 shadow-sm"
            >
                Get in Touch
            </a>

            <!-- Mobile Menu Toggle -->
            <button
                id="menu-toggle"
                class="md:hidden p-2 rounded-full hover:bg-surface-container transition-colors text-on-background"
                aria-label="Toggle Menu"
            >
                <Icon name="mdi:menu" class="w-6 h-6" id="menu-icon-open" />
                <Icon
                    name="mdi:close"
                    class="w-6 h-6 hidden"
                    id="menu-icon-close"
                />
            </button>
        </div>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div
        id="mobile-menu"
        class="hidden md:hidden absolute top-full left-0 right-0 bg-surface-container-lowest border-b border-outline-variant/30 shadow-lg py-6 px-6 transition-all duration-300"
    >
        <nav class="flex flex-col gap-4">
            <a
                href="#home"
                class="mobile-link nav-link text-base font-medium text-on-surface-variant hover:text-primary transition-colors py-2"
                data-nav="home"
                >Home</a
            >
            <a
                href="#about"
                class="mobile-link nav-link text-base font-medium text-on-surface-variant hover:text-primary transition-colors py-2"
                data-nav="about"
                >About Me</a
            >
            <a
                href="#skills"
                class="mobile-link nav-link text-base font-medium text-on-surface-variant hover:text-primary transition-colors py-2"
                data-nav="skills"
                >Skills</a
            >
            <a
                href="#experience"
                class="mobile-link nav-link text-base font-medium text-on-surface-variant hover:text-primary transition-colors py-2"
                data-nav="experience"
                >Experience</a
            >
            <a
                href="#projects"
                class="mobile-link nav-link text-base font-medium text-on-surface-variant hover:text-primary transition-colors py-2"
                data-nav="projects"
                >Projects</a
            >
            <a
                href="#contact"
                class="mobile-link nav-link text-base font-medium text-on-surface-variant hover:text-primary transition-colors py-2"
                data-nav="contact"
                >Contact</a
            >
            <a
                href="#contact"
                class="mobile-link inline-flex items-center justify-center bg-primary text-white text-base font-medium py-3 rounded-full hover:bg-primary-container transition-colors mt-2"
            >
                Get in Touch
            </a>
        </nav>
    </div>
</header>

<style>
    .nav-link {
        position: relative;
    }
    .nav-link::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 0;
        height: 2px;
        background: var(--color-primary);
        transition: width 0.3s ease;
    }
    .nav-link.active {
        color: var(--color-primary);
    }
    .nav-link.active::after {
        width: 100%;
    }
    /* Mobile active state: left border accent */
    #mobile-menu .nav-link.active {
        color: var(--color-primary);
        font-weight: 700;
    }
</style>

<script>
    const header = document.getElementById("main-header");
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const openIcon = document.getElementById("menu-icon-open");
    const closeIcon = document.getElementById("menu-icon-close");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    window.addEventListener("scroll", () => {
        if (window.scrollY > 50) {
            header?.classList.add("shadow-sm", "border-outline-variant/20");
            header?.classList.remove("border-transparent");
        } else {
            header?.classList.remove("shadow-sm", "border-outline-variant/20");
            header?.classList.add("border-transparent");
        }
    });

    menuToggle?.addEventListener("click", () => {
        const isHidden = mobileMenu?.classList.contains("hidden");
        if (isHidden) {
            mobileMenu?.classList.remove("hidden");
            openIcon?.classList.add("hidden");
            closeIcon?.classList.remove("hidden");
        } else {
            mobileMenu?.classList.add("hidden");
            openIcon?.classList.remove("hidden");
            closeIcon?.classList.add("hidden");
        }
    });

    mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
            mobileMenu?.classList.add("hidden");
            openIcon?.classList.remove("hidden");
            closeIcon?.classList.add("hidden");
        });
    });

    // Scrollspy: highlight nav link of section currently in viewport
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
    const sectionIds = ["home", "about", "skills", "experience", "projects", "contact"];
    const sections = sectionIds
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => el !== null);

    const setActive = (id: string) => {
        navLinks.forEach((link) => {
            const isActive = link.dataset.nav === id;
            link.classList.toggle("active", isActive);
            if (isActive) {
                link.classList.add("text-primary");
                link.classList.remove("text-on-background", "text-on-surface-variant");
            } else {
                link.classList.remove("text-primary");
                if (link.classList.contains("mobile-link")) {
                    link.classList.add("text-on-surface-variant");
                } else if (!link.classList.contains("text-white")) {
                    link.classList.add("text-on-background");
                }
            }
        });
    };

    // Smooth scroll with header offset on nav click
    navLinks.forEach((link) => {
        link.addEventListener("click", (e) => {
            const href = link.getAttribute("href");
            if (href?.startsWith("#")) {
                const id = href.slice(1) || "home";
                const target = document.getElementById(id);
                if (target) {
                    e.preventDefault();
                    const headerOffset = header ? header.offsetHeight + 12 : 72;
                    const top = target.getBoundingClientRect().top + window.scrollY - headerOffset;
                    window.scrollTo({ top, behavior: "smooth" });
                    history.pushState(null, "", href);
                }
            }
        });
    });

    const spyObserver = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    setActive(entry.target.id);
                }
            });
        },
        { rootMargin: "-35% 0px -55% 0px", threshold: 0 }
    );

    sections.forEach((s) => spyObserver.observe(s));

    const onScrollSpyFallback = () => {
        if (window.scrollY < 100) setActive("home");
    };
    window.addEventListener("scroll", onScrollSpyFallback, { passive: true });
    onScrollSpyFallback();
</script>
