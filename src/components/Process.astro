---
import { Icon } from 'astro-icon/components';
---

<section id="process" class="py-20 md:py-32 px-5 desktop:px-16 max-w-[1280px] mx-auto border-t border-outline-variant/20">
  <!-- Section Header -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 mb-16 items-end">
    <div class="col-span-1 md:col-span-7 flex flex-col gap-2">
      <span class="text-sm font-bold tracking-widest text-primary uppercase">Development Process</span>
      <h3 class="text-3xl md:text-5xl font-extrabold tracking-tight text-on-background leading-tight">
        From Idea to Production
      </h3>
    </div>
    <div class="col-span-1 md:col-span-5 pb-1">
      <p class="text-body-lg text-on-surface-variant leading-relaxed">
        My development process focuses on understanding the problem, designing the solution, building the product, and continuously improving it.
      </p>
    </div>
  </div>

  <!-- Process Steps Grid -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-8">

    <!-- Step 1 -->
    <div class="bg-white border border-outline-variant/30 rounded-2xl p-6 relative flex flex-col justify-between hover:border-primary/30 transition-all duration-300">
      <div>
        <span class="text-xs font-black text-primary bg-primary/10 px-2.5 py-1 rounded-full uppercase tracking-wider">Phase 01</span>
        <h4 class="text-lg font-extrabold text-on-background mt-6 mb-2">Discover & Research</h4>
        <p class="text-sm text-on-surface-variant leading-relaxed">
          Understand the problem, requirements, users, and goals of the project.
        </p>
      </div>
      <div class="mt-8 border-t border-outline-variant/20 pt-4 flex items-center justify-between text-outline text-xs">
        <span>Project Goals</span>
        <Icon name="mdi:compass-outline" class="w-4 h-4 text-primary" />
      </div>
    </div>

    <!-- Step 2 -->
    <div class="bg-white border border-outline-variant/30 rounded-2xl p-6 relative flex flex-col justify-between hover:border-primary/30 transition-all duration-300">
      <div>
        <span class="text-xs font-black text-primary bg-primary/10 px-2.5 py-1 rounded-full uppercase tracking-wider">Phase 02</span>
        <h4 class="text-lg font-extrabold text-on-background mt-6 mb-2">Plan & Design</h4>
        <p class="text-sm text-on-surface-variant leading-relaxed">
          Create the system structure, database, flow, wireframes, and interface.
        </p>
      </div>
      <div class="mt-8 border-t border-outline-variant/20 pt-4 flex items-center justify-between text-outline text-xs">
        <span>System Planning</span>
        <Icon name="mdi:layers-outline" class="w-4 h-4 text-primary" />
      </div>
    </div>

    <!-- Step 3 -->
    <div class="bg-white border border-outline-variant/30 rounded-2xl p-6 relative flex flex-col justify-between hover:border-primary/30 transition-all duration-300">
      <div>
        <span class="text-xs font-black text-primary bg-primary/10 px-2.5 py-1 rounded-full uppercase tracking-wider">Phase 03</span>
        <h4 class="text-lg font-extrabold text-on-background mt-6 mb-2">Develop</h4>
        <p class="text-sm text-on-surface-variant leading-relaxed">
          Build the frontend, backend, database, APIs, and application functionality.
        </p>
      </div>
      <div class="mt-8 border-t border-outline-variant/20 pt-4 flex items-center justify-between text-outline text-xs">
        <span>Application Build</span>
        <Icon name="mdi:palette-swatch-outline" class="w-4 h-4 text-primary" />
      </div>
    </div>

    <!-- Step 4 -->
    <div class="bg-white border border-outline-variant/30 rounded-2xl p-6 relative flex flex-col justify-between hover:border-primary/30 transition-all duration-300">
      <div>
        <span class="text-xs font-black text-primary bg-primary/10 px-2.5 py-1 rounded-full uppercase tracking-wider">Phase 04</span>
        <h4 class="text-lg font-extrabold text-on-background mt-6 mb-2">Test & Deploy</h4>
        <p class="text-sm text-on-surface-variant leading-relaxed">
          Test the application, fix issues, optimize performance, and prepare it for production.
        </p>
      </div>
      <div class="mt-8 border-t border-outline-variant/20 pt-4 flex items-center justify-between text-outline text-xs">
        <span>Production Ready</span>
        <Icon name="mdi:rocket-launch-outline" class="w-4 h-4 text-primary" />
      </div>
    </div>

  </div>
</section>
