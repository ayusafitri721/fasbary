---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import avatarImage from "../assets/gueh.jpg";
---

<section
    id="home"
    class="relative pt-28 pb-16 overflow-hidden min-h-screen flex flex-col justify-between px-5 desktop:px-16 max-w-[1280px] mx-auto"
>
    <!-- Soft blue color band: full-width, follows content height -->
    <div
        class="absolute bottom-0 left-0 w-full h-[60%] bg-gradient-to-t from-secondary-container/70 via-secondary-container/40 to-transparent -z-10 pointer-events-none"
    >
    </div>

    <!-- Oversized background typography -->
    <div
        id="watermark-parallax"
        class="absolute inset-0 select-none pointer-events-none -z-10 flex items-center justify-center overflow-hidden"
    >
        <h1
            class="text-[clamp(80px,14vw,240px)] font-black text-on-surface/[0.035] tracking-tighter leading-none whitespace-nowrap uppercase"
        >
            NAMRY DEVELOPER
        </h1>
    </div>

    <!-- 3-Column Layout -->
    <div
        class="grid grid-cols-1 md:grid-cols-12 gap-6 items-stretch my-auto w-full pt-4"
    >
        <!-- Left Column -->
        <div
            class="col-span-1 md:col-span-4 flex flex-col justify-between gap-8 z-10 py-2 items-center text-center md:items-start md:text-left"
        >
            <!-- Top Left: I'M NAMRY AYU SAFITRI + Button -->
            <div class="flex flex-col gap-4 items-center md:items-start">
                <div class="flex flex-col leading-none">
                    <span class="name-mask"
                        ><span
                            class="hero-name text-4xl lg:text-6xl font-black italic tracking-tight text-on-background"
                            >I'M</span
                        ></span
                    >
                    <span class="name-mask mt-1"
                        ><span
                            class="hero-name text-4xl lg:text-5xl font-black tracking-tight text-on-background"
                            >NAMRY AYU</span
                        ></span
                    >
                    <span class="name-mask mt-1"
                        ><span
                            class="hero-name text-4xl lg:text-5xl font-black tracking-tight text-primary"
                            >SAFITRI</span
                        ></span
                    >
                </div>

                <div class="hero-actions flex flex-col sm:flex-row md:flex-col lg:flex-row gap-3 items-center md:items-start mt-2">
                    <a
                        href="https://wa.me/6281220178122?text=Hi%20Namry!%20Saya%20tertarik%20untuk%20mengajak%20kolaborasi%20dengan%20kamu.%20Boleh%20kita%20diskusi%20lebih%20lanjut%3F"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hero-btn inline-flex items-center gap-2 bg-primary hover:bg-primary-container text-on-primary text-sm font-medium px-6 py-3 rounded-full transition-all duration-300 hover:-translate-y-0.5 shadow-md hover:shadow-lg group"
                    >
                        Get in Touch
                        <Icon
                            name="mdi:arrow-right"
                            class="w-4 h-4 transition-transform group-hover:translate-x-1"
                        />
                    </a>
                    <a
                        href="/cv-namry-ayu-safitri.pdf"
                        download
                        class="hero-btn hero-cv-btn inline-flex items-center gap-2 border border-primary/30 bg-surface-container-lowest text-primary hover:bg-secondary-container text-sm font-medium px-6 py-3 rounded-full transition-all duration-300 hover:-translate-y-0.5 shadow-sm hover:shadow-md group"
                    >
                        Download CV
                        <Icon name="mdi:download" class="w-4 h-4" />
                    </a>
                </div>
            </div>

            <!-- Bottom Left: Intro sentence -->
            <div class="max-w-[340px] mt-auto md:text-left">
                <p
                    class="hero-desc text-base lg:text-lg font-medium text-on-background leading-relaxed"
                >
Hello, I'm Namry Ayu Safitri, a Full-Stack Developer
Enthusiast. I build web apps and turn rough ideas into working
products.
                </p>
            </div>
        </div>

        <!-- Center Column: Avatar Image Asset -->
        <div
            class="col-span-1 md:col-span-4 relative flex justify-center items-end z-10 min-h-[420px] lg:min-h-[500px]"
        >
            <div
                class="relative w-full max-w-[340px] h-full flex items-end justify-center"
            >
                <!-- Portrait Cropped Avatar Image -->
                <Image
                    src={avatarImage}
                    alt="Namry Ayu Safitri Avatar"
                    class="aspect-[3/4] w-full max-h-[520px] object-cover object-center rounded-3xl shadow-xl border border-white/40 hover:scale-[1.02] transition-transform duration-500"
                    loading="eager"
                />
            </div>
        </div>

        <!-- Right Column -->
        <div
            class="col-span-1 md:col-span-4 flex flex-col justify-between gap-8 z-10 py-2 items-center text-center md:text-right md:items-end"
        >
            <!-- Top Right: Follow Me & Socials -->
            <div class="flex flex-col gap-3 items-center max-w-[280px] md:max-w-none md:items-end">
                <h4 class="hero-follow text-base font-bold text-on-background">
                    Follow Me
                </h4>

                <!-- Social Circle Buttons -->
                <div class="flex gap-2.5 justify-center md:justify-end">
                    <a
                        href="https://github.com/ayusafitri721"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hero-social w-9 h-9 rounded-full bg-secondary-container/60 hover:bg-primary hover:text-on-primary border border-outline-variant/30 flex items-center justify-center text-primary transition-all duration-300 shadow-sm"
                        aria-label="GitHub"
                    >
                        <Icon name="mdi:github" class="w-4 h-4" />
                    </a>
                    <a
                        href="https://www.linkedin.com/in/ayusafitri21/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hero-social w-9 h-9 rounded-full bg-secondary-container/60 hover:bg-primary hover:text-on-primary border border-outline-variant/30 flex items-center justify-center text-primary transition-all duration-300 shadow-sm"
                        aria-label="LinkedIn"
                    >
                        <Icon name="mdi:linkedin" class="w-4 h-4" />
                    </a>
                    <a
                        href="https://www.instagram.com/fasbary/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hero-social w-9 h-9 rounded-full bg-secondary-container/60 hover:bg-primary hover:text-on-primary border border-outline-variant/30 flex items-center justify-center text-primary transition-all duration-300 shadow-sm"
                        aria-label="Instagram"
                    >
                        <Icon name="mdi:instagram" class="w-4 h-4" />
                    </a>
                    <a
                        href="https://www.tiktok.com/@codebuddy.id"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hero-social w-9 h-9 rounded-full bg-secondary-container/60 hover:bg-primary hover:text-on-primary border border-outline-variant/30 flex items-center justify-center text-primary transition-all duration-300 shadow-sm"
                        aria-label="TikTok"
                    >
                        <Icon name="mdi:music-note" class="w-4 h-4" />
                    </a>
                </div>

                <p
                    class="hero-tagline text-sm text-on-surface-variant font-medium leading-tight mt-1"
                >
                    I BUILD WEB & Mobile Apps
                </p>

                <div class="flex flex-wrap gap-2 mt-1 justify-center md:justify-end">
                    <span
                        class="hero-badge text-[9px] font-bold bg-surface-container-lowest border border-outline-variant/30 text-on-surface px-2 py-0.5 rounded"
                        >FULL-STACK</span
                    >
                    <span
                        class="hero-badge text-[9px] font-bold bg-surface-container-lowest border border-outline-variant/30 text-on-surface px-2 py-0.5 rounded"
                        >TEAM WORK</span
                    >
                    <span
                        class="hero-badge text-[9px] font-bold bg-surface-container-lowest border border-outline-variant/30 text-on-surface px-2 py-0.5 rounded"
                        >MOBILE DEV</span
                    >
                </div>
            </div>

            <!-- Bottom Right: FULL-STACK DEVELOPER ENTHUSIAST -->
            <div class="mt-auto">
                <h2
                    class="text-3xl lg:text-5xl font-extrabold uppercase tracking-tight text-on-background leading-none"
                >
                    <span class="hero-line">FULL-STACK</span>
                    <span class="hero-line">DEVELOPER</span>
                    <span class="hero-line">ENTHUSIAST</span>
                </h2>
            </div>
        </div>
    </div>
</section>

<style>
    /* ===== Hero entrance — smooth, simple, no bounce =====
       One easing for everything, small distances, short stagger.
       Total sequence ~0.7s, not 0.85s+. */
    :root { --hero-ease: cubic-bezier(0.22, 1, 0.36, 1); }

    @keyframes heroFadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes heroFadeDown {
        from { opacity: 0; transform: translateY(-10px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes heroMaskReveal {
        from { transform: translateY(105%); }
        to   { transform: translateY(0); }
    }
    @keyframes heroScaleIn {
        from { opacity: 0; transform: scale(0.96); }
        to   { opacity: 1; transform: scale(1); }
    }
    @keyframes heroWatermarkIn {
        from { opacity: 0; transform: translateX(-16px); }
        to   { opacity: 1; transform: translateX(0); }
    }
    @keyframes heroAvatarIn {
        from { opacity: 0; transform: translateY(18px) scale(0.97); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* Watermark: subtle, short */
    section > div:nth-of-type(2) h1 {
        animation: heroWatermarkIn 0.8s var(--hero-ease) 0.05s both;
    }

    .name-mask { display: block; overflow: hidden; }
    .hero-name {
        display: block;
        animation: heroMaskReveal 0.65s var(--hero-ease) both;
    }
    .name-mask:nth-child(1) .hero-name { animation-delay: 0.08s; }
    .name-mask:nth-child(2) .hero-name { animation-delay: 0.16s; }
    .name-mask:nth-child(3) .hero-name { animation-delay: 0.24s; }

    /* Follow Me */
    .hero-follow {
        animation: heroFadeDown 0.55s var(--hero-ease) 0.1s both;
    }

    /* Social icons: simple fade + slight lift, no overshoot bounce */
    .hero-social {
        animation: heroFadeUp 0.5s var(--hero-ease) both;
    }
    .hero-social:nth-of-type(1) { animation-delay: 0.18s; }
    .hero-social:nth-of-type(2) { animation-delay: 0.24s; }
    .hero-social:nth-of-type(3) { animation-delay: 0.3s; }
    .hero-social:nth-of-type(4) { animation-delay: 0.36s; }

    .hero-btn {
        animation: heroFadeUp 0.55s var(--hero-ease) 0.32s both;
    }
    .hero-tagline {
        animation: heroFadeUp 0.55s var(--hero-ease) 0.38s both;
    }

    .hero-badge {
        display: inline-block;
        animation: heroScaleIn 0.45s var(--hero-ease) both;
    }
    .hero-badge:nth-child(1) { animation-delay: 0.42s; }
    .hero-badge:nth-child(2) { animation-delay: 0.48s; }
    .hero-badge:nth-child(3) { animation-delay: 0.54s; }

    /* Right headline: gentle fade-up, not 48px slide from right */
    .hero-line {
        display: block;
        animation: heroFadeUp 0.6s var(--hero-ease) both;
    }
    .hero-line:nth-child(1) { animation-delay: 0.42s; }
    .hero-line:nth-child(2) { animation-delay: 0.5s; }
    .hero-line:nth-child(3) { animation-delay: 0.58s; }

    section img[alt*="Avatar"] {
        animation: heroAvatarIn 0.7s var(--hero-ease) 0.15s both;
    }

    .hero-desc {
        animation: heroFadeUp 0.6s var(--hero-ease) 0.48s both;
    }

    @media (prefers-reduced-motion: reduce) {
        section > div:nth-of-type(2) h1,
        .hero-name, .hero-follow, .hero-social,
        .hero-btn, .hero-tagline, .hero-badge,
        .hero-line, section img[alt*="Avatar"], .hero-desc {
            animation: none !important;
            opacity: 1; transform: none;
        }
    }
</style>

<script>
    const watermark = document.getElementById("watermark-parallax");

    if (watermark) {
        let raf = null;

        window.addEventListener("mousemove", (e) => {
            if (raf) return;
            raf = requestAnimationFrame(() => {
                const x = (e.clientX / window.innerWidth - 0.5) * 14;
                const y = (e.clientY / window.innerHeight - 0.5) * 10;
                watermark.style.transform = `translate(${x}px, ${y}px)`;
                raf = null;
            });
        });
    }
</script>
