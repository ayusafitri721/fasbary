---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import aboutImage from "../assets/gueh_2.jpeg";
---

<section
    id="about"
    class="relative py-20 md:py-32 px-5 desktop:px-16 max-w-[1280px] mx-auto"
>
    <!-- Continuation of the hero color band, fading out halfway through this section -->
    <div
        class="absolute top-0 left-0 w-full h-1/2 bg-gradient-to-b from-secondary-container/60 via-secondary-container/30 to-transparent -z-10 pointer-events-none"
    >
    </div>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-center">
        <!-- Left Column: Technical Blueprint & Code Architecture Card -->
        <div class="col-span-1 md:col-span-6 relative">
            <!-- Single Photo Card -->
            <div
                class="about-photo relative rounded-3xl overflow-hidden shadow-xl shadow-on-surface/[0.05] border border-white/40"
            >
                <Image
                    src={aboutImage}
                    alt="Namry Ayu Safitri"
                    class="about-photo-img w-full aspect-[4/3] object-cover object-center"
                    loading="lazy"
                />
            </div>
        </div>

        <!-- Right Column: Text Information -->
        <div class="col-span-1 md:col-span-6 flex flex-col gap-6">
            <div class="flex flex-col gap-2">
                <span
                    class="about-label text-sm font-bold tracking-widest text-primary uppercase"
                    >About Me</span
                >
                <h3
                    class="text-3xl md:text-5xl font-extrabold tracking-tight text-on-background leading-tight"
                >
                    <span class="about-mask"
                        ><span class="about-line about-line-1">From Rough Ideas</span></span
                    >
                    <span class="about-mask"
                        ><span class="about-line about-line-2">To Working Products</span></span
                    >
                </h3>
            </div>

            <p class="about-p1 text-body-lg text-on-surface-variant leading-relaxed">
                I'm a Full-Stack Developer Enthusiast who likes taking an idea
                and turning it into something that actually works. I work across
                frontend, backend, databases, and app development, and I'm
                always picking up new tech.
            </p>

            <p class="about-p2 text-body-md text-on-surface-variant/80 leading-relaxed">
                Whether designing an interface or building a full web app, I
                care about clean code, responsive UI, and products that solve
                real problems.
            </p>

            <div class="pt-4">
                <a
                    href="#projects"
                    class="about-btn inline-flex items-center gap-3 bg-primary hover:bg-primary-container text-white px-8 py-3.5 rounded-full font-medium transition-all duration-300 hover:-translate-y-0.5 hover:scale-[1.03] shadow-md shadow-primary/20 hover:shadow-xl hover:shadow-primary/30 group"
                >
                    View Projects
                    <Icon
                        name="mdi:arrow-right"
                        class="w-5 h-5 transition-transform group-hover:translate-x-1"
                    />
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    /* ===== About Me — smooth reveal ===== */
    :root { --about-ease: cubic-bezier(0.22, 1, 0.36, 1); }

    section.about-init .about-photo { opacity: 0; }
    section.about-init .about-photo-img { transform: scale(1.06); }
    section.about-init .about-label,
    section.about-init .about-p1,
    section.about-init .about-p2,
    section.about-init .about-btn { opacity: 0; }
    section.about-init .about-line { transform: translateY(105%); }

    .about-mask { display: block; overflow: hidden; }
    .about-line { display: block; }

    section.in-view .about-photo {
        animation: aboutFadeUp 0.7s var(--about-ease) 0.05s both;
    }
    section.in-view .about-photo-img {
        animation: aboutZoomOut 0.9s var(--about-ease) 0.05s both;
    }
    section.in-view .about-label {
        animation: aboutFadeDown 0.5s var(--about-ease) 0.12s both;
    }
    section.in-view .about-line-1 {
        animation: aboutMaskReveal 0.6s var(--about-ease) 0.2s both;
    }
    section.in-view .about-line-2 {
        animation: aboutMaskReveal 0.6s var(--about-ease) 0.28s both;
    }
    section.in-view .about-p1 {
        animation: aboutFadeUp 0.6s var(--about-ease) 0.4s both;
    }
    section.in-view .about-p2 {
        animation: aboutFadeUp 0.6s var(--about-ease) 0.48s both;
    }
    section.in-view .about-btn {
        animation: aboutFadeUp 0.6s var(--about-ease) 0.56s both;
    }

    @keyframes aboutZoomOut {
        from { transform: scale(1.06); }
        to   { transform: scale(1); }
    }
    @keyframes aboutFadeDown {
        from { opacity: 0; transform: translateY(-10px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes aboutMaskReveal {
        from { transform: translateY(105%); }
        to   { transform: translateY(0); }
    }
    @keyframes aboutFadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
        section.about-init .about-photo,
        section.about-init .about-photo-img,
        section.about-init .about-label,
        section.about-init .about-line,
        section.about-init .about-p1,
        section.about-init .about-p2,
        section.about-init .about-btn { opacity: 1; transform: none; }
        section.in-view .about-photo,
        section.in-view .about-photo-img,
        section.in-view .about-label,
        section.in-view .about-line-1,
        section.in-view .about-line-2,
        section.in-view .about-p1,
        section.in-view .about-p2,
        section.in-view .about-btn { animation: none; }
    }
</style>

<script>
    const about = document.getElementById("about");

    if (about) {
        about.classList.add("about-init");

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        about.classList.add("in-view");
                        observer.disconnect();
                    }
                });
            },
            { threshold: 0.2 }
        );

        observer.observe(about);
    }
</script>
