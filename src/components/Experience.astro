<section
    id="experience"
    class="py-20 md:py-32 px-5 desktop:px-16 max-w-[1280px] mx-auto"
>
    <!-- Section Header -->
    <div class="mb-16 max-w-2xl flex flex-col gap-2">
        <span
            class="exp-label text-sm font-bold tracking-widest text-primary uppercase"
            >Experience</span
        >
        <h3
            class="exp-title text-3xl md:text-5xl font-extrabold tracking-tight text-on-background leading-tight"
        >
            What I've Built & Learned
        </h3>
        <p class="exp-desc text-body-lg text-on-surface-variant leading-relaxed">
            Every project and role has taught me something new about building software.
        </p>
    </div>

    <!-- Rows List -->
    <div class="flex flex-col border-t border-outline-variant/30 mt-8">
        <!-- Current Education -->
        <div
            class="exp-row grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-8 border-b border-outline-variant/30 items-center hover:bg-surface-container-lowest/50 px-2 transition-all duration-300"
        >
            <div
                class="col-span-1 md:col-span-2 text-label-md text-on-surface-variant font-medium"
            >
                2026 - Present
            </div>
            <div class="col-span-1 md:col-span-7">
                <h4 class="text-xl font-bold text-on-background">
                    Undergraduate Information Systems Student
                </h4>
                <p class="text-sm text-on-surface-variant mt-1">
                    Studying information systems at UPN Veteran Jakarta.
                </p>
            </div>
            <div
                class="col-span-1 md:col-span-3 text-left md:text-right text-lg font-semibold text-primary"
            >
                UPN Veteran Jakarta
            </div>
        </div>

        <!-- Experience Row 1 -->
        <div
            class="exp-row grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-8 border-b border-outline-variant/30 items-center hover:bg-surface-container-lowest/50 px-2 transition-all duration-300"
        >
            <div
                class="col-span-1 md:col-span-2 text-label-md text-on-surface-variant font-medium"
            >
                2026
            </div>
            <div class="col-span-1 md:col-span-7">
                <h4 class="text-xl font-bold text-on-background">
                    Full-Stack Web Developer Intern
                </h4>
                <p class="text-sm text-on-surface-variant mt-1">
                    Built and maintained web apps across frontend and backend, worked
                    with APIs and databases, and shipped features for a live
                    product.
                </p>
            </div>
            <div
                class="col-span-1 md:col-span-3 text-left md:text-right text-lg font-semibold text-primary"
            >
                Rahmah Group International
            </div>
        </div>

        <!-- Experience Row 2 -->
        <div
            class="exp-row grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-8 border-b border-outline-variant/30 items-center hover:bg-surface-container-lowest/50 px-2 transition-all duration-300"
        >
            <div
                class="col-span-1 md:col-span-2 text-label-md text-on-surface-variant font-medium"
            >
                2023 - 2026
            </div>
            <div class="col-span-1 md:col-span-7">
                <h4 class="text-xl font-bold text-on-background">
                    Software Engineering Student
                </h4>
                <p class="text-sm text-on-surface-variant mt-1">
                    Studied software engineering and built web, mobile, and
                    database apps, while taking part in tech projects and
                    competitions.
                </p>
            </div>
            <div
                class="col-span-1 md:col-span-3 text-left md:text-right text-lg font-semibold text-primary"
            >
                SMKN 24 Jakarta
            </div>
        </div>
    </div>
</section>

<style>
    /* ===== Experience — smooth vertical reveal =====
       Two-phase: hidden only after JS adds .exp-init, animates when .in-view */
    :root { --exp-ease: cubic-bezier(0.22, 1, 0.36, 1); }

    /* hidden state — applied immediately on load */
    #experience.exp-init .exp-label,
    #experience.exp-init .exp-title,
    #experience.exp-init .exp-desc,
    #experience.exp-init .exp-row { opacity: 0; }
    #experience.exp-init .exp-row { transform: translateY(20px); }

    /* animate when section enters viewport — smooth & visible */
    #experience.in-view .exp-label {
        animation: expLabelIn 0.6s var(--exp-ease) 0.05s both;
    }
    #experience.in-view .exp-title {
        animation: expUp 0.7s var(--exp-ease) 0.12s both;
    }
    #experience.in-view .exp-desc {
        animation: expUp 0.7s var(--exp-ease) 0.18s both;
    }
    #experience.in-view .exp-row {
        animation: expRowIn 0.7s var(--exp-ease) both;
    }
    #experience.in-view .exp-row:nth-of-type(1) { animation-delay: 0.26s; }
    #experience.in-view .exp-row:nth-of-type(2) { animation-delay: 0.36s; }
    #experience.in-view .exp-row:nth-of-type(3) { animation-delay: 0.46s; }

    @keyframes expUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes expLabelIn {
        from { opacity: 0; transform: translateY(-10px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes expRowIn {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
        #experience.exp-init .exp-label,
        #experience.exp-init .exp-title,
        #experience.exp-init .exp-desc,
        #experience.exp-init .exp-row { opacity: 1; transform: none; }
        #experience.in-view .exp-label,
        #experience.in-view .exp-title,
        #experience.in-view .exp-desc,
        #experience.in-view .exp-row { animation: none; }
    }
</style>

<script>
    const expSection = document.getElementById("experience");
    if (expSection) {
        expSection.classList.add("exp-init");
        if ("IntersectionObserver" in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            expSection.classList.add("in-view");
                            observer.disconnect();
                        }
                    });
                },
                { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
            );
            observer.observe(expSection);
        } else {
            expSection.classList.add("in-view");
        }
    }
</script>
