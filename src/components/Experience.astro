---

---

<section
    id="experience"
    class="py-20 md:py-32 px-5 desktop:px-16 max-w-[1280px] mx-auto"
>
    <!-- Section Header -->
    <div
        class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 mb-16 items-end"
    >
        <div class="col-span-1 md:col-span-7 flex flex-col gap-2">
            <span
                class="text-sm font-bold tracking-widest text-primary uppercase"
                >Experience</span
            >
            <h3
                class="text-3xl md:text-5xl font-extrabold tracking-tight text-on-background leading-tight"
            >
                My Journey in Technology
            </h3>
        </div>
        <div class="col-span-1 md:col-span-5 pb-1">
            <p class="text-body-lg text-on-surface-variant leading-relaxed">
                Every project and experience has helped me grow as a developer
                and strengthen my passion for technology.
            </p>
        </div>
    </div>

    <!-- Rows List -->
    <div class="flex flex-col border-t border-outline-variant/30 mt-8">
        <!-- Current Education -->
        <div
            class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-8 border-b border-outline-variant/30 items-center hover:bg-surface-container-lowest/50 px-2 transition-all duration-300"
        >
            <div
                class="col-span-1 md:col-span-2 text-label-md text-on-surface-variant font-medium"
            >
                2026 - Present
            </div>
            <div class="col-span-1 md:col-span-7">
                <h4 class="text-xl font-bold text-on-background">
                    Undergraduate Information Systems Student
                </h4>
                <p class="text-sm text-on-surface-variant mt-1">
                    Continuing my journey in technology and information systems
                    at UPN Veteran Jakarta.
                </p>
            </div>
            <div
                class="col-span-1 md:col-span-3 text-left md:text-right text-lg font-semibold text-primary"
            >
                UPN Veteran Jakarta
            </div>
        </div>

        <!-- Experience Row 1 -->
        <div
            class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-8 border-b border-outline-variant/30 items-center hover:bg-surface-container-lowest/50 px-2 transition-all duration-300"
        >
            <div
                class="col-span-1 md:col-span-2 text-label-md text-on-surface-variant font-medium"
            >
                2026
            </div>
            <div class="col-span-1 md:col-span-7">
                <h4 class="text-xl font-bold text-on-background">
                    Full-Stack Web Developer Intern
                </h4>
                <p class="text-sm text-on-surface-variant mt-1">
                    Developed and maintained web applications across frontend
                    and backend, worked with APIs and databases, and
                    contributed to real-world product development.
                </p>
            </div>
            <div
                class="col-span-1 md:col-span-3 text-left md:text-right text-lg font-semibold text-primary"
            >
                Rahmah Group International
            </div>
        </div>

        <!-- Experience Row 2 -->
        <div
            class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-8 border-b border-outline-variant/30 items-center hover:bg-surface-container-lowest/50 px-2 transition-all duration-300"
        >
            <div
                class="col-span-1 md:col-span-2 text-label-md text-on-surface-variant font-medium"
            >
                2023 - 2026
            </div>
            <div class="col-span-1 md:col-span-7">
                <h4 class="text-xl font-bold text-on-background">
                    Software Engineering Student
                </h4>
                <p class="text-sm text-on-surface-variant mt-1">
                    Studied software engineering while building web, mobile,
                    and database-based applications and participating in
                    technology projects and competitions.
                </p>
            </div>
            <div
                class="col-span-1 md:col-span-3 text-left md:text-right text-lg font-semibold text-primary"
            >
                SMKN 24 Jakarta
            </div>
        </div>

    </div>
</section>
