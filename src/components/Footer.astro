          <p class="text-lg font-medium text-white/80 dark:text-on-surface/80 mt-2">Full-Stack Developer Enthusiast</p>
          <p class="text-sm text-white/70 dark:text-on-surface-variant mt-4">Turning ideas into code.</p>
        </div>
        <div class="flex gap-3 mt-2">
          <a href="https://github.com/ayusafitri721" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white dark:bg-surface-container-lowest flex items-center justify-center text-[#002b9e] dark:text-primary hover:bg-white/90 dark:hover:bg-surface-container transition-transform duration-200 hover:scale-105 shadow-md" aria-label="GitHub"><Icon name="mdi:github" class="w-5 h-5" /></a>
          <a href="https://www.linkedin.com/in/ayusafitri21/" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white dark:bg-surface-container-lowest flex items-center justify-center text-[#002b9e] dark:text-primary hover:bg-white/90 dark:hover:bg-surface-container transition-transform duration-200 hover:scale-105 shadow-md" aria-label="LinkedIn"><Icon name="mdi:linkedin" class="w-5 h-5" /></a>
          <a href="https://www.instagram.com/fasbary/" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white dark:bg-surface-container-lowest flex items-center justify-center text-[#002b9e] dark:text-primary hover:bg-white/90 dark:hover:bg-surface-container transition-transform duration-200 hover:scale-105 shadow-md" aria-label="Instagram"><Icon name="mdi:instagram" class="w-5 h-5" /></a>
          <a href="https://www.tiktok.com/@codebuddy.id" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white dark:bg-surface-container-lowest flex items-center justify-center text-[#002b9e] dark:text-primary hover:bg-white/90 dark:hover:bg-surface-container transition-transform duration-200 hover:scale-105 shadow-md" aria-label="TikTok"><Icon name="mdi:music-note" class="w-5 h-5" /></a>
        </div>
      </div>

      <div class="col-span-1 lg:col-span-6 grid grid-cols-2 sm:grid-cols-3 gap-8">
        <div class="flex flex-col gap-3">
          <h5 class="text-sm font-semibold text-white dark:text-on-surface tracking-wide">Navigation</h5>
          <nav class="flex flex-col gap-2.5 text-sm text-white/80 dark:text-on-surface-variant">
            <a href="#home" class="hover:text-white dark:hover:text-on-surface transition-colors">Home</a>
            <a href="#about" class="hover:text-white dark:hover:text-on-surface transition-colors">About Me</a>
            <a href="#skills" class="hover:text-white dark:hover:text-on-surface transition-colors">Skills</a>
            <a href="#experience" class="hover:text-white dark:hover:text-on-surface transition-colors">Experience</a>
            <a href="#projects" class="hover:text-white dark:hover:text-on-surface transition-colors">Projects</a>
            <a href="#contact" class="hover:text-white dark:hover:text-on-surface transition-colors">Contact</a>
          </nav>
        </div>

        <div class="flex flex-col gap-3">
          <h5 class="text-sm font-semibold text-white dark:text-on-surface tracking-wide">Skills</h5>
          <nav class="flex flex-col gap-2.5 text-sm text-white/80 dark:text-on-surface-variant">
            <a href="#skills" class="hover:text-white dark:hover:text-on-surface transition-colors">Frontend Development</a>
            <a href="#skills" class="hover:text-white dark:hover:text-on-surface transition-colors">Backend Development</a>
            <a href="#skills" class="hover:text-white dark:hover:text-on-surface transition-colors">Database</a>
            <a href="#skills" class="hover:text-white dark:hover:text-on-surface transition-colors">Mobile Development</a>
          </nav>
        </div>

        <div class="flex flex-col gap-3">
          <h5 class="text-sm font-semibold text-white dark:text-on-surface tracking-wide">Connect</h5>
          <nav class="flex flex-col gap-2.5 text-sm text-white/80 dark:text-on-surface-variant">
            <a href="https://github.com/ayusafitri721" target="_blank" rel="noopener noreferrer" class="hover:text-white dark:hover:text-on-surface transition-colors">GitHub</a>
            <a href="https://www.linkedin.com/in/ayusafitri21/" target="_blank" rel="noopener noreferrer" class="hover:text-white dark:hover:text-on-surface transition-colors">LinkedIn</a>
            <a href="https://www.instagram.com/fasbary/" target="_blank" rel="noopener noreferrer" class="hover:text-white dark:hover:text-on-surface transition-colors">Instagram</a>
            <a href="https://www.tiktok.com/@codebuddy.id" target="_blank" rel="noopener noreferrer" class="hover:text-white dark:hover:text-on-surface transition-colors">TikTok</a>
          </nav>
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row justify-between items-center py-6 border-t border-white/10 dark:border-outline-variant/25 text-xs text-white/80 dark:text-on-surface-variant gap-4">
      <span>&copy; 2026 Namry Ayu Safitri. All Rights Reserved.</span>
    </div>

    <div class="w-full text-center overflow-hidden select-none pointer-events-none -mb-4 sm:-mb-8 md:-mb-12">
      <h2 class="text-[20vw] leading-none font-extrabold tracking-tighter text-white/10 dark:text-on-surface/[0.06] uppercase font-sans">NAMRY</h2>
    </div>
  </div>
</footer>

<style>
  :root { --footer-ease: cubic-bezier(0.22, 1, 0.36, 1); }
  #site-footer .footer-reveal { opacity: 0; transform: translateY(14px); }
  #site-footer.in-view .footer-reveal { animation: footerIn 0.6s var(--footer-ease) 0.08s both; }
  @keyframes footerIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) {
    #site-footer .footer-reveal { opacity: 1; transform: none; }
    #site-footer.in-view .footer-reveal { animation: none; }
  }
</style>

<script>
  const footer = document.getElementById("site-footer");
  if (footer && "IntersectionObserver" in window) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { footer.classList.add("in-view"); obs.disconnect(); }});
    }, { threshold: 0.15 });
    obs.observe(footer);
  } else {
    footer?.classList.add("in-view");
  }
</script>
