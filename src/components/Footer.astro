---
import { Icon } from "astro-icon/components";
---

<footer id="site-footer" class="bg-gradient-to-b from-[#002b9e] via-[#001f78] to-[#001047] text-white dark:from-[#1e2027] dark:via-[#17181e] dark:to-[#101216] dark:text-on-surface pt-16 pb-0 px-6 desktop:px-16 relative overflow-hidden">
  <div class="absolute inset-0 opacity-15 dark:opacity-10 pointer-events-none blueprint-grid"></div>
  <div class="max-w-[1280px] mx-auto relative z-10 flex flex-col justify-between min-h-[480px]">
    <div data-reveal class="footer-reveal grid grid-cols-1 lg:grid-cols-12 gap-12 pt-4 pb-12 items-start">
      <div class="col-span-1 lg:col-span-6 flex flex-col gap-6">
        <div>
