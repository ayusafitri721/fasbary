---
import { Icon } from "astro-icon/components";
---

<footer class="bg-gradient-to-b from-[#002b9e] via-[#001f78] to-[#001047] text-white pt-16 pb-0 px-6 desktop:px-16 relative overflow-hidden">
  <div class="absolute inset-0 opacity-15 pointer-events-none blueprint-grid"></div>
  <div class="max-w-[1280px] mx-auto relative z-10 flex flex-col justify-between min-h-[480px]">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 pt-4 pb-12 items-start">
      <div class="col-span-1 lg:col-span-6 flex flex-col gap-6">
        <div>
          <p class="text-2xl font-semibold text-white tracking-tight">Namry Ayu Safitri</p>
          <p class="text-lg font-medium text-white/80 mt-2">Full-Stack Developer Enthusiast</p>
          <p class="text-sm text-white/70 mt-4">Let's build, learn, and create.</p>
        </div>
        <div class="flex gap-3 mt-2">
          <a href="https://github.com/ayusafitri721" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white flex items-center justify-center text-[#002b9e] hover:bg-white/90 transition-transform duration-200 hover:scale-105 shadow-md" aria-label="GitHub"><Icon name="mdi:github" class="w-5 h-5" /></a>
          <a href="https://www.linkedin.com/in/ayusafitri21/" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white flex items-center justify-center text-[#002b9e] hover:bg-white/90 transition-transform duration-200 hover:scale-105 shadow-md" aria-label="LinkedIn"><Icon name="mdi:linkedin" class="w-5 h-5" /></a>
          <a href="https://www.instagram.com/fasbary/" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white flex items-center justify-center text-[#002b9e] hover:bg-white/90 transition-transform duration-200 hover:scale-105 shadow-md" aria-label="Instagram"><Icon name="mdi:instagram" class="w-5 h-5" /></a>
          <a href="https://www.tiktok.com/@codebuddy.id" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white flex items-center justify-center text-[#002b9e] hover:bg-white/90 transition-transform duration-200 hover:scale-105 shadow-md" aria-label="TikTok"><Icon name="mdi:music-note" class="w-5 h-5" /></a>
        </div>
      </div>

      <div class="col-span-1 lg:col-span-6 grid grid-cols-2 sm:grid-cols-3 gap-8">
        <div class="flex flex-col gap-3">
          <h5 class="text-sm font-semibold text-white tracking-wide">Navigation</h5>
          <nav class="flex flex-col gap-2.5 text-sm text-white/80">
            <a href="#" class="hover:text-white transition-colors">Home</a>
            <a href="#about" class="hover:text-white transition-colors">About Me</a>
            <a href="#skills" class="hover:text-white transition-colors">Skills</a>
            <a href="#experience" class="hover:text-white transition-colors">Experience</a>
            <a href="#projects" class="hover:text-white transition-colors">Projects</a>
            <a href="#contact" class="hover:text-white transition-colors">Contact</a>
          </nav>
        </div>

        <div class="flex flex-col gap-3">
          <h5 class="text-sm font-semibold text-white tracking-wide">Skills</h5>
          <nav class="flex flex-col gap-2.5 text-sm text-white/80">
            <a href="#skills" class="hover:text-white transition-colors">Frontend Development</a>
            <a href="#skills" class="hover:text-white transition-colors">Backend Development</a>
            <a href="#skills" class="hover:text-white transition-colors">Database</a>
            <a href="#skills" class="hover:text-white transition-colors">Mobile Development</a>
          </nav>
        </div>

        <div class="flex flex-col gap-3">
          <h5 class="text-sm font-semibold text-white tracking-wide">Connect</h5>
          <nav class="flex flex-col gap-2.5 text-sm text-white/80">
            <a href="https://github.com/ayusafitri721" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GitHub</a>
            <a href="https://www.linkedin.com/in/ayusafitri21/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">LinkedIn</a>
            <a href="https://www.instagram.com/fasbary/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Instagram</a>
            <a href="https://www.tiktok.com/@codebuddy.id" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">TikTok</a>
          </nav>
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row justify-between items-center py-6 border-t border-white/10 text-xs text-white/80 gap-4">
      <span>&copy; 2026 Namry Ayu Safitri. All Rights Reserved.</span>
    </div>

    <div class="w-full text-center overflow-hidden select-none pointer-events-none -mb-4 sm:-mb-8 md:-mb-12">
      <h2 class="text-[20vw] leading-none font-extrabold tracking-tighter text-white/10 uppercase font-sans">NAMRY</h2>
    </div>
  </div>
</footer>
