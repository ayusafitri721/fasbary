---
import { Icon } from 'astro-icon/components';
---

<section id="skills" class="py-20 md:py-32 px-5 desktop:px-16 max-w-[1280px] mx-auto">
  <!-- Section Header -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 mb-16 items-end">
    <div class="col-span-1 md:col-span-7 flex flex-col gap-2">
      <span class="text-sm font-bold tracking-widest text-primary uppercase">Skills</span>
      <h3 class="text-3xl md:text-5xl font-extrabold tracking-tight text-on-background leading-tight">
        Technologies I Work With
      </h3>
    </div>
    <div class="col-span-1 md:col-span-5 pb-1">
      <p class="text-body-lg text-on-surface-variant leading-relaxed">
        Exploring different technologies to build reliable, responsive, and user-focused digital products.
      </p>
    </div>
  </div>

  <!-- Skills Grid -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-8">

    <!-- Skill Category 01: Frontend Development -->
    <div class="col-span-1 md:col-span-6">
      <div class="h-full bg-white border border-outline-variant/30 rounded-2xl p-8 hover:border-primary/30 hover:shadow-xl hover:shadow-on-surface/[0.02] transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-center mb-6">
            <span class="text-6xl font-black text-outline-variant/30 select-none">01</span>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
              <Icon name="mdi:application-brackets-outline" class="w-6 h-6" />
            </div>
          </div>
          <h4 class="text-2xl font-bold text-on-background mb-4">Frontend Development</h4>
          <p class="text-body-md text-on-surface-variant leading-relaxed mb-6">
            Building responsive, dynamic, and clean web interfaces using modern frameworks and styling tools.
          </p>

          <!-- Skill Tags -->
          <div class="flex flex-wrap gap-2">
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:react" class="w-3.5 h-3.5" />React.js</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:nextdotjs" class="w-3.5 h-3.5" />Next.js</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:javascript" class="w-3.5 h-3.5" />JavaScript</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:html5" class="w-3.5 h-3.5" />HTML</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:css3" class="w-3.5 h-3.5" />CSS</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:bootstrap" class="w-3.5 h-3.5" />Bootstrap</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:tailwindcss" class="w-3.5 h-3.5" />Tailwind CSS</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:astro" class="w-3.5 h-3.5" />Astro</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Skill Category 02: Backend Development -->
    <div class="col-span-1 md:col-span-6">
      <div class="h-full bg-white border border-outline-variant/30 rounded-2xl p-8 hover:border-primary/30 hover:shadow-xl hover:shadow-on-surface/[0.02] transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-center mb-6">
            <span class="text-6xl font-black text-outline-variant/30 select-none">02</span>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
              <Icon name="mdi:server" class="w-6 h-6" />
            </div>
          </div>
          <h4 class="text-2xl font-bold text-on-background mb-4">Backend Development</h4>
          <p class="text-body-md text-on-surface-variant leading-relaxed mb-6">
            Developing robust server-side logic, structured REST APIs, and efficient application workflows.
          </p>

          <!-- Skill Tags -->
          <div class="flex flex-wrap gap-2">
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:laravel" class="w-3.5 h-3.5" />Laravel</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:nodedotjs" class="w-3.5 h-3.5" />Node.js</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:php" class="w-3.5 h-3.5" />PHP</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:python" class="w-3.5 h-3.5" />Python</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="mdi:api" class="w-3.5 h-3.5" />REST API</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:javascript" class="w-3.5 h-3.5" />JavaScript</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:c" class="w-3.5 h-3.5" />C</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:cplusplus" class="w-3.5 h-3.5" />C++</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Skill Category 03: Database & Tools -->
    <div class="col-span-1 md:col-span-6">
      <div class="h-full bg-white border border-outline-variant/30 rounded-2xl p-8 hover:border-primary/30 hover:shadow-xl hover:shadow-on-surface/[0.02] transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-center mb-6">
            <span class="text-6xl font-black text-outline-variant/30 select-none">03</span>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
              <Icon name="mdi:database" class="w-6 h-6" />
            </div>
          </div>
          <h4 class="text-2xl font-bold text-on-background mb-4">Database & Tools</h4>
          <p class="text-body-md text-on-surface-variant leading-relaxed mb-6">
            Managing relational databases, containerizing environments, API testing, and version control.
          </p>

          <!-- Skill Tags -->
          <div class="flex flex-wrap gap-2">
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:mysql" class="w-3.5 h-3.5" />MySQL</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:docker" class="w-3.5 h-3.5" />Docker</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:postman" class="w-3.5 h-3.5" />Postman</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:git" class="w-3.5 h-3.5" />Git</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:github" class="w-3.5 h-3.5" />GitHub</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:laragon" class="w-3.5 h-3.5" />Laragon</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:xampp" class="w-3.5 h-3.5" />XAMPP</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Skill Category 04: Mobile Development -->
    <div class="col-span-1 md:col-span-6">
      <div class="h-full bg-white border border-outline-variant/30 rounded-2xl p-8 hover:border-primary/30 hover:shadow-xl hover:shadow-on-surface/[0.02] transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-center mb-6">
            <span class="text-6xl font-black text-outline-variant/30 select-none">04</span>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
              <Icon name="mdi:cellphone" class="w-6 h-6" />
            </div>
          </div>
          <h4 class="text-2xl font-bold text-on-background mb-4">Mobile Development</h4>
          <p class="text-body-md text-on-surface-variant leading-relaxed mb-6">
            Creating cross-platform and native mobile applications with intuitive UI and smooth user flow.
          </p>

          <!-- Skill Tags -->
          <div class="flex flex-wrap gap-2">
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:flutter" class="w-3.5 h-3.5" />Flutter</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:dart" class="w-3.5 h-3.5" />Dart</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:kotlin" class="w-3.5 h-3.5" />Kotlin</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:openjdk" class="w-3.5 h-3.5" />Java</span>
            <span class="text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:react" class="w-3.5 h-3.5" />React Native</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
