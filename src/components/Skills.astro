---
import { Icon } from 'astro-icon/components';
---

<section id="skills" class="py-20 md:py-32 px-5 desktop:px-16 max-w-[1280px] mx-auto">
  <!-- Section Header -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 mb-16 items-end">
    <div class="col-span-1 md:col-span-7 flex flex-col gap-2">
      <span class="skills-label text-sm font-bold tracking-widest text-primary uppercase">Skills</span>
      <h3 class="skills-title text-3xl md:text-5xl font-extrabold tracking-tight text-on-background leading-tight">
        Technologies I Work With
      </h3>
    </div>
    <div class="col-span-1 md:col-span-5 pb-1">
      <p class="skills-desc text-body-lg text-on-surface-variant leading-relaxed">
        Technologies I use to build fast, responsive, and user-friendly products.
      </p>
    </div>
  </div>

  <!-- Skills Grid -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-8">

    <!-- Skill Category 01: Frontend Development -->
    <!-- Pair 1: Frontend + Backend share one row -->
    <div class="col-span-1 md:col-span-6 skill-card">
      <div class="h-full bg-surface-container-lowest border border-outline-variant/30 rounded-2xl p-8 hover:border-primary/30 hover:shadow-lg hover:shadow-on-surface/[0.03] transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-center mb-6">
            <span class="text-6xl font-black text-outline-variant/30 select-none">01</span>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
              <Icon name="mdi:application-brackets-outline" class="w-6 h-6" />
            </div>
          </div>
          <h4 class="text-2xl font-bold text-on-background mb-4">Frontend Development</h4>
          <p class="text-body-md text-on-surface-variant leading-relaxed mb-6">
            Building responsive, clean web interfaces with modern frameworks and styling tools.
          </p>

          <!-- Skill Tags -->
          <div class="flex flex-wrap gap-2 justify-start">
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:react" class="w-3.5 h-3.5" />React.js</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:nextdotjs" class="w-3.5 h-3.5" />Next.js</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:javascript" class="w-3.5 h-3.5" />JavaScript</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:html5" class="w-3.5 h-3.5" />HTML</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:css3" class="w-3.5 h-3.5" />CSS</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:bootstrap" class="w-3.5 h-3.5" />Bootstrap</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:tailwindcss" class="w-3.5 h-3.5" />Tailwind CSS</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:astro" class="w-3.5 h-3.5" />Astro</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Skill Category 02: Backend Development -->
    <div class="col-span-1 md:col-span-6 skill-card">
      <div class="h-full bg-surface-container-lowest border border-outline-variant/30 rounded-2xl p-8 hover:border-primary/30 hover:shadow-lg hover:shadow-on-surface/[0.03] transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-center mb-6">
            <span class="text-6xl font-black text-outline-variant/30 select-none">02</span>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
              <Icon name="mdi:server" class="w-6 h-6" />
            </div>
          </div>
          <h4 class="text-2xl font-bold text-on-background mb-4">Backend Development</h4>
          <p class="text-body-md text-on-surface-variant leading-relaxed mb-6">
            Writing server-side logic, structured REST APIs, and efficient application workflows.
          </p>

          <!-- Skill Tags -->
          <div class="flex flex-wrap gap-2 justify-start">
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:laravel" class="w-3.5 h-3.5" />Laravel</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:nodedotjs" class="w-3.5 h-3.5" />Node.js</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:php" class="w-3.5 h-3.5" />PHP</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:python" class="w-3.5 h-3.5" />Python</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="mdi:api" class="w-3.5 h-3.5" />REST API</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:express" class="w-3.5 h-3.5" />Express.js</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Skill Category 03: Database & Tools -->
    <div class="col-span-1 md:col-span-6 skill-card">
      <div class="h-full bg-surface-container-lowest border border-outline-variant/30 rounded-2xl p-8 hover:border-primary/30 hover:shadow-lg hover:shadow-on-surface/[0.03] transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-center mb-6">
            <span class="text-6xl font-black text-outline-variant/30 select-none">03</span>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
              <Icon name="mdi:database" class="w-6 h-6" />
            </div>
          </div>
          <h4 class="text-2xl font-bold text-on-background mb-4">Database & Tools</h4>
          <p class="text-body-md text-on-surface-variant leading-relaxed mb-6">
            Working with relational databases, API testing, and version control.
          </p>

          <!-- Skill Tags -->
          <div class="flex flex-wrap gap-2 justify-start">
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:mysql" class="w-3.5 h-3.5" />MySQL</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:postman" class="w-3.5 h-3.5" />Postman</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:git" class="w-3.5 h-3.5" />Git</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:github" class="w-3.5 h-3.5" />GitHub</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:laragon" class="w-3.5 h-3.5" />Laragon</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:xampp" class="w-3.5 h-3.5" />XAMPP</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Skill Category 04: Mobile Development -->
    <div class="col-span-1 md:col-span-6 skill-card">
      <div class="h-full bg-surface-container-lowest border border-outline-variant/30 rounded-2xl p-8 hover:border-primary/30 hover:shadow-lg hover:shadow-on-surface/[0.03] transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-center mb-6">
            <span class="text-6xl font-black text-outline-variant/30 select-none">04</span>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
              <Icon name="mdi:cellphone" class="w-6 h-6" />
            </div>
          </div>
          <h4 class="text-2xl font-bold text-on-background mb-4">Mobile Development</h4>
          <p class="text-body-md text-on-surface-variant leading-relaxed mb-6">
            Building cross-platform and native mobile apps with a UI that's easy to use and flows naturally.
          </p>

          <!-- Skill Tags -->
          <div class="flex flex-wrap gap-2 justify-start">
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:flutter" class="w-3.5 h-3.5" />Flutter</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:dart" class="w-3.5 h-3.5" />Dart</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:kotlin" class="w-3.5 h-3.5" />Kotlin</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:openjdk" class="w-3.5 h-3.5" />Java</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:android" class="w-3.5 h-3.5" />React Native</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Skill Category 05: Programming Languages -->
    <div class="col-span-1 md:col-span-6 skill-card">
      <div class="h-full bg-surface-container-lowest border border-outline-variant/30 rounded-2xl p-8 hover:border-primary/30 hover:shadow-lg hover:shadow-on-surface/[0.03] transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-center mb-6">
            <span class="text-6xl font-black text-outline-variant/30 select-none">05</span>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
              <Icon name="mdi:code-braces" class="w-6 h-6" />
            </div>
          </div>
          <h4 class="text-2xl font-bold text-on-background mb-4">Programming Languages</h4>
          <p class="text-body-md text-on-surface-variant leading-relaxed mb-6">
            Core languages for problem solving, algorithms, and systems development.
          </p>

          <!-- Skill Tags -->
          <div class="flex flex-wrap gap-2 justify-start">
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:c" class="w-3.5 h-3.5" />C</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="simple-icons:cplusplus" class="w-3.5 h-3.5" />C++</span>
          </div>
        </div>
      </div>
    </div>

  <!-- Skill Category 06: Soft Skills -->
    <div class="col-span-1 md:col-span-6 skill-card">
      <div class="h-full bg-surface-container-lowest border border-outline-variant/30 rounded-2xl p-8 hover:border-primary/30 hover:shadow-lg hover:shadow-on-surface/[0.03] transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-center mb-6">
            <span class="text-6xl font-black text-outline-variant/30 select-none">06</span>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
              <Icon name="mdi:account-group-outline" class="w-6 h-6" />
            </div>
          </div>
          <h4 class="text-2xl font-bold text-on-background mb-4">Soft Skills</h4>
          <p class="text-body-md text-on-surface-variant leading-relaxed mb-6">
            Collaboration, clear communication, and adaptability to keep projects moving and teams aligned.
          </p>

          <!-- Skill Tags -->
          <div class="flex flex-wrap gap-2 justify-start">
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="mdi:account-group" class="w-3.5 h-3.5" />Teamwork</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="mdi:chat-processing-outline" class="w-3.5 h-3.5" />Communication</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="mdi:clock-outline" class="w-3.5 h-3.5" />Time Management</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="mdi:lightbulb-on-outline" class="w-3.5 h-3.5" />Problem Solving</span>
            <span class="skill-tag text-xs font-semibold bg-surface-container text-on-surface px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><Icon name="mdi:book-open-page-variant-outline" class="w-3.5 h-3.5" />Continuous Learning</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
    /* ===== Skills — smooth reveal ===== */
    :root { --skills-ease: cubic-bezier(0.22, 1, 0.36, 1); }

    section.skills-init .skills-label,
    section.skills-init .skills-title,
    section.skills-init .skills-desc,
    section.skills-init .skill-card { opacity: 0; }

    section.in-view .skills-label {
        animation: skillsFadeDown 0.5s var(--skills-ease) 0.05s both;
    }
    section.in-view .skills-title {
        animation: skillsFadeUp 0.6s var(--skills-ease) 0.12s both;
    }
    section.in-view .skills-desc {
        animation: skillsFadeUp 0.6s var(--skills-ease) 0.18s both;
    }

    section.in-view .skill-card {
        animation: skillsCardIn 0.6s var(--skills-ease) both;
    }
    section.in-view .skill-card:nth-of-type(1) { animation-delay: 0.22s; }
    section.in-view .skill-card:nth-of-type(2) { animation-delay: 0.30s; }
    section.in-view .skill-card:nth-of-type(3) { animation-delay: 0.38s; }
    section.in-view .skill-card:nth-of-type(4) { animation-delay: 0.46s; }
    section.in-view .skill-card:nth-of-type(5) { animation-delay: 0.54s; }
    section.in-view .skill-card:nth-of-type(6) { animation-delay: 0.62s; }

    /* tags: fade gently, no pop */
    section.skills-init .skill-tag { opacity: 0; }
    section.in-view .skill-tag {
        animation: skillsTagIn 0.4s var(--skills-ease) both;
    }
    /* per-card stagger for tags via JS delay is not needed — simple 0.05s increment per card already enough */

    @keyframes skillsFadeDown {
        from { opacity: 0; transform: translateY(-8px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes skillsFadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes skillsCardIn {
        from { opacity: 0; transform: translateY(18px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes skillsTagIn {
        from { opacity: 0; transform: translateY(4px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
        section.skills-init .skills-label,
        section.skills-init .skills-title,
        section.skills-init .skills-desc,
        section.skills-init .skill-card,
        section.skills-init .skill-tag { opacity: 1; }
        section.in-view .skills-label,
        section.in-view .skills-title,
        section.in-view .skills-desc,
        section.in-view .skill-card,
        section.in-view .skill-tag { animation: none; }
    }
</style>

<script>
    const skills = document.getElementById("skills");

    if (skills) {
        skills.classList.add("skills-init");

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        skills.classList.add("in-view");
                        observer.disconnect();
                    }
                });
            },
            { threshold: 0.15 }
        );

        observer.observe(skills);
    }
</script>
