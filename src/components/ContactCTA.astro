---
import { Icon } from 'astro-icon/components';
import { Image } from "astro:assets";
import avatarImage from "../assets/gueh.jpg";
---

<section id="contact" class="relative py-16 md:py-24 px-3 md:px-5 desktop:px-16 max-w-[1280px] mx-auto overflow-visible">
  <div data-reveal class="contact-card relative min-h-[430px] overflow-visible rounded-[2rem] border border-sky-200/70 bg-[linear-gradient(rgba(94,165,217,0.18)_1px,transparent_1px),linear-gradient(90deg,rgba(94,165,217,0.18)_1px,transparent_1px),linear-gradient(90deg,#cfeeff_0%,#eaf7ff_56%,#f8fcff_100%)] bg-[size:64px_64px,64px_64px,auto] shadow-[0_4px_20px_rgba(0,0,0,0.04)] dark:border-outline-variant/40 dark:bg-[linear-gradient(rgba(94,165,217,0.08)_1px,transparent_1px),linear-gradient(90deg,rgba(94,165,217,0.08)_1px,transparent_1px),linear-gradient(90deg,#1c2533_0%,#161d29_56%,#131924_100%)]">
    <div class="relative z-10 max-w-[600px] px-7 py-12 sm:px-10 md:px-20 md:py-20 lg:px-24">
      <h3 class="text-[32px] md:text-[38px] lg:text-[42px] font-extrabold tracking-[-0.04em] text-[#05070a] leading-[1.22] dark:text-[#e6ecf7]">
        Let's Build Something <br class="hidden sm:block" />
        <span class="italic">Together</span>
      </h3>

      <p class="mt-6 max-w-[540px] text-[17px] md:text-[19px] text-slate-600 leading-relaxed dark:text-slate-300">
        Open to new opportunities, collaborations, or just exchanging ideas. If you have something in mind, let's talk.
      </p>

      <a href="https://wa.me/6281220178122?text=Hi%20Namry!%20Saya%20tertarik%20untuk%20mengajak%20kolaborasi%20dengan%20kamu.%20Boleh%20kita%20diskusi%20lebih%20lanjut%3F" target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex items-center gap-3 rounded-full bg-primary hover:bg-primary-container px-7 py-3.5 text-sm font-semibold text-on-primary shadow-md transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg group">
        Get In Touch
        <Icon name="mdi:arrow-right" class="w-5 h-5 transition-transform group-hover:translate-x-1" />
      </a>
    </div>

    <!-- Right Column: Portrait Visual -->
    <div class="relative z-20 mx-auto -mt-4 flex w-full justify-center px-8 md:absolute md:bottom-0 md:right-10 md:mt-0 md:w-[360px] md:px-0 lg:right-20 lg:w-[420px]">
      <div class="relative w-[260px] sm:w-[300px] md:w-[360px] lg:w-[400px]">
        <Image
          src={avatarImage}
          alt="Namry Ayu Safitri"
          class="relative aspect-[3/4] w-full rounded-t-[2rem] object-cover object-center shadow-lg ring-1 ring-white/50"
          loading="lazy"
        />
      </div>
     </div>
   </div>
 </section>

<style>
  /* Contact — smooth reveal, same ease as global */
  :root { --contact-ease: cubic-bezier(0.22, 1, 0.36, 1); }
  #contact .contact-card {
    opacity: 0;
    transform: translateY(18px);
  }
  #contact.in-view .contact-card {
    animation: contactIn 0.7s var(--contact-ease) 0.08s both;
  }
  @keyframes contactIn {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    #contact .contact-card { opacity: 1; transform: none; }
    #contact.in-view .contact-card { animation: none; }
  }
</style>

<script>
  const contact = document.getElementById("contact");
  if (contact && "IntersectionObserver" in window) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { contact.classList.add("in-view"); obs.disconnect(); }
      });
    }, { threshold: 0.15 });
    obs.observe(contact);
  } else {
    contact?.classList.add("in-view");
  }
</script>
