const filterOptions = [
  { key: "all", label: "All Projects", accent: "#0037b0", soft: "#e6eaff" },
  { key: "full-stack", label: "Full-Stack", accent: "#7c3aed", soft: "#ede9fe" },
  { key: "ui-ux", label: "UI/UX Design", accent: "#059669", soft: "#d1fae5" },
  { key: "web", label: "Web App", accent: "#ea580c", soft: "#ffedd5" },
  { key: "mobile", label: "Mobile App", accent: "#db2777", soft: "#fce7f3" },
  { key: "game", label: "Game", accent: "#2563eb", soft: "#dbeafe" },
];

const allProjects = [...featuredProjects, ...supportingProjects];

const filterCounts = Object.fromEntries(
  filterOptions.map((option) => [
    option.key,
    option.key === "all"
      ? allProjects.length
      : allProjects.filter((project) => project.filterCategories.includes(option.key)).length,
  ]),
);
---

<section id="projects" class="py-20 md:py-32 px-5 desktop:px-16 max-w-[1440px] mx-auto overflow-hidden">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-end">
    <div class="col-span-1 md:col-span-7 flex flex-col gap-3">
      <span class="proj-label text-sm font-bold tracking-widest text-primary uppercase">Projects</span>
      <h3 class="proj-title text-4xl md:text-6xl font-extrabold tracking-tight text-on-background leading-tight">
        Selected Work & <br /> Case Studies
      </h3>
    </div>
    <div class="col-span-1 md:col-span-5 pb-1">
      <p class="proj-desc text-body-lg text-on-surface-variant leading-relaxed max-w-md md:ml-auto">
        A selection of web, mobile, and full-stack projects, built to solve practical problems with clean interfaces.
      </p>
    </div>
  </div>

  <!-- Project Filter Chips -->
  <div class="proj-filters mt-8 grid grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:gap-2.5 sm:items-center sm:justify-center">
    {filterOptions.map((option) => (
      <button
        type="button"
        class:list={["project-filter-btn w-full sm:w-auto justify-center", { active: option.key === "all" }]}
        data-filter={option.key}
        style={`--chip-accent: ${option.accent}; --chip-soft: ${option.soft};`}
      >
        <span class="proj-chip-label">{option.label}</span>
        <span class="proj-chip-count">{filterCounts[option.key]}</span>
      </button>
    ))}
  </div>

  <div id="featured-projects-grid" class="mt-14 md:mt-20 grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8">
    {featuredProjects.map((project, index) => (
      <article 
        class="proj-card group relative overflow-hidden rounded-[2rem] border border-outline-variant/30 bg-surface-container-lowest p-5 md:p-6 shadow-xl shadow-on-surface/[0.03] transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-2xl hover:shadow-primary/10"
        data-project-card
        data-project-category={project.filterCategories.join(" ")}
      >
        <div class="absolute inset-0 blueprint-grid opacity-[0.18]"></div>
        <div class="absolute -right-24 -top-24 h-56 w-56 rounded-full bg-primary/10 blur-3xl transition-opacity duration-300 group-hover:opacity-80"></div>

        <div class="relative z-10 flex min-h-[340px] flex-col justify-between gap-6">
          <div class="flex items-start justify-between gap-6">
            <div>
              <span class="inline-flex rounded-full bg-primary/10 px-3 py-1 text-xs font-bold uppercase tracking-wide text-primary">
                Featured Project
              </span>
              <p class="mt-3 text-xs font-semibold uppercase tracking-[0.2em] text-on-surface-variant/70">
                0{index + 1} / {project.category}
              </p>
            </div>
            <span class="rounded-full border border-outline-variant/30 bg-surface px-3 py-1.5 text-xs font-bold text-on-background">
              {project.year}
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-[1fr_180px] gap-6 items-center">
            <div>
              <h4 class="text-2xl md:text-3xl font-extrabold tracking-tight text-on-background leading-tight">
                {project.title}
              </h4>
              <p class="mt-3 text-sm font-bold text-primary">{project.role}</p>
              <p class="mt-4 text-[15px] md:text-base leading-relaxed text-on-surface-variant">
                {project.description}
              </p>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {project.technologies.map((technology) => (
                  <span class="rounded-full border border-outline-variant/30 bg-surface-container-lowest px-2.5 py-1 text-[11px] font-semibold text-on-surface-variant">
                    {technology}
                  </span>
                ))}
              </div>
            </div>

            <div 
              class={`relative overflow-hidden rounded-3xl border border-outline-variant/30 bg-gradient-to-br from-secondary-container/70 to-white shadow-lg group/img w-full md:w-[180px] aspect-[4/3] md:aspect-[3/4] flex flex-col shrink-0 ${project.images?.length ? "project-card-multi" : project.image ? "cursor-pointer project-card-preview" : ""}`}
              data-img-src={project.image && !project.images?.length ? project.image.src : ""}
              data-project-title={project.title}
            >
              <!-- Mock Browser Header -->
              <div class="flex items-center justify-between px-4 py-2.5 bg-surface-container-lowest/80 backdrop-blur-sm border-b border-outline-variant/20 z-10">
                <div class="flex gap-1.5">
                  <span class="h-2 w-2 rounded-full bg-red-400/80"></span>
                  <span class="h-2 w-2 rounded-full bg-yellow-400/80"></span>
                  <span class="h-2 w-2 rounded-full bg-green-400/80"></span>
                </div>
                <Icon name={project.icon} class="h-4 w-4 text-primary" />
              </div>
              
              <!-- Image / Wireframe Area -->
              <div class="relative flex-1 overflow-hidden bg-secondary-container/10">
                {project.images && project.images.length > 0 ? (
                  <div class="grid h-full grid-cols-2 gap-1.5 p-1.5">
                    {project.images.map((img, imgIndex) =>
                      img ? (
                        <button
                          type="button"
                          class={`preview-photo group/photo relative cursor-pointer overflow-hidden rounded-lg border border-outline-variant/20 bg-surface-container-lowest focus:outline-none ${project.images.length === 1 ? "col-span-2" : ""}`}
                          data-img-src={typeof img === "string" ? img : img.src}
                          aria-label={`Preview ${project.title} photo ${imgIndex + 1}`}
                        >
                          {typeof img === "string" ? (
                            <img
                              src={img}
                              alt={`${project.title} photo ${imgIndex + 1}`}
                              class="h-full w-full object-cover object-top transition-transform duration-500 group-hover/photo:scale-105"
                              loading="lazy"
                            />
                          ) : (
                            <Image
                              src={img}
                              alt={`${project.title} photo ${imgIndex + 1}`}
                              class="h-full w-full object-cover object-top transition-transform duration-500 group-hover/photo:scale-105"
                              loading="lazy"
                            />
                          )}
                          <span class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 transition-opacity duration-300 group-hover/photo:opacity-100">
                            <span class="rounded-full bg-white/95 p-2 text-primary shadow-lg">
                              <Icon name="mdi:magnify" class="h-4 w-4" />
                            </span>
                          </span>
                        </button>
                      ) : (
                        <div class="flex min-h-0 flex-col gap-1.5 rounded-lg border border-dashed border-outline-variant/40 bg-secondary-container/10 p-2">
                          <div class="h-8 rounded-md bg-primary/10"></div>
                          <div class="grid grid-cols-2 gap-1">
                            <div class="h-6 rounded bg-white/70"></div>
                            <div class="h-6 rounded bg-white/70"></div>
                          </div>
                          <div class="mt-auto h-2 w-3/4 rounded-full bg-outline-variant/20"></div>
                          <span class="text-[9px] font-black uppercase tracking-wider text-on-surface-variant/50">Photo {imgIndex + 1}</span>
                        </div>
                      ),
                    )}
                  </div>
                ) : project.image ? (
                  <div class="relative w-full h-full">
                    <Image 
                      src={project.image} 
                      alt={`${project.title} screenshot`}
                      class="absolute inset-x-0 bottom-0 top-3 w-full h-[calc(100%-12px)] object-cover object-[center_9%] transition-transform duration-500 group-hover/img:scale-105"
                    />
                    <div class="absolute inset-x-0 bottom-0 top-3 bg-black/40 opacity-0 group-hover/img:opacity-100 flex items-center justify-center transition-opacity duration-300">
                      <div class="bg-white/95 text-primary p-2.5 rounded-full shadow-lg transform translate-y-3 group-hover/img:translate-y-0 transition-all duration-300">
                        <Icon name="mdi:magnify" class="h-5 w-5" />
                      </div>
                    </div>
                  </div>
                ) : (
                  <div class="p-4 space-y-3">
                    <div class="h-14 rounded-xl bg-primary/10"></div>
                    <div class="grid grid-cols-2 gap-2">
                      <div class="h-10 rounded-lg bg-white/70"></div>
                      <div class="h-10 rounded-lg bg-white/70"></div>
                    </div>
                    <div class="h-3 w-2/3 rounded-full bg-outline-variant/20 mt-2"></div>
                  </div>
                )}
              </div>
            </div>
          </div>

          <div class="flex flex-col gap-4 border-t border-outline-variant/20 pt-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex flex-wrap gap-2">
              {project.focus.map((item) => (
                <span class="text-xs font-bold uppercase tracking-wide text-on-surface-variant/70">{item}</span>
              ))}
            </div>
            <a href={project.demoUrl || project.githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-bold text-primary transition-colors hover:text-primary-container">
              Discuss Project
              <Icon name="mdi:arrow-top-right" class="h-4 w-4" />
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div id="supporting-projects-grid" class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8">
    {supportingProjects.map((project, index) => (
      <article 
        class="proj-card group relative overflow-hidden rounded-[2rem] border border-outline-variant/30 bg-surface-container-lowest p-5 md:p-6 shadow-xl shadow-on-surface/[0.03] transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-2xl hover:shadow-primary/10"
        data-project-card
        data-project-category={project.filterCategories.join(" ")}
      >
        <div class="absolute inset-0 blueprint-grid opacity-[0.18]"></div>
        <div class="absolute -right-24 -top-24 h-56 w-56 rounded-full bg-primary/10 blur-3xl transition-opacity duration-300 group-hover:opacity-80"></div>

        <div class="relative z-10 flex min-h-[340px] flex-col justify-between gap-6">
          <div class="flex items-start justify-between gap-6">
            <div>
              <span class="inline-flex rounded-full bg-primary/10 px-3 py-1 text-xs font-bold uppercase tracking-wide text-primary">
                {project.platform ?? "Supporting Project"}
              </span>
              <p class="mt-3 text-xs font-semibold uppercase tracking-[0.2em] text-on-surface-variant/70">
                0{index + 3} / {project.category}
              </p>
            </div>
            <span class="rounded-full border border-outline-variant/30 bg-surface px-3 py-1.5 text-xs font-bold text-on-background">
              {project.year}
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-[1fr_180px] gap-6 items-center">
            <div>
              <h4 class="text-2xl md:text-3xl font-extrabold tracking-tight text-on-background leading-tight">
                {project.title}
              </h4>
              <p class="mt-3 text-sm font-bold text-primary">{project.role}</p>
              <p class="mt-4 text-[15px] md:text-base leading-relaxed text-on-surface-variant">
                {project.description}
              </p>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {project.technologies.map((technology) => (
                  <span class="rounded-full border border-outline-variant/30 bg-surface-container-lowest px-2.5 py-1 text-[11px] font-semibold text-on-surface-variant">
                    {technology}
                  </span>
                ))}
              </div>
            </div>

            <div 
              class={`relative overflow-hidden rounded-3xl border border-outline-variant/30 bg-gradient-to-br from-secondary-container/70 to-white shadow-lg group/img w-full md:w-[180px] aspect-[4/3] md:aspect-[3/4] flex flex-col shrink-0 ${project.images?.length ? "project-card-multi" : project.image ? "cursor-pointer project-card-preview" : ""}`}
              data-img-src={project.image && !project.images?.length ? project.image.src : ""}
              data-project-title={project.title}
            >
              <!-- Mock Browser Header -->
              <div class="flex items-center justify-between px-4 py-2.5 bg-surface-container-lowest/80 backdrop-blur-sm border-b border-outline-variant/20 z-10">
                <div class="flex gap-1.5">
                  <span class="h-2 w-2 rounded-full bg-red-400/80"></span>
                  <span class="h-2 w-2 rounded-full bg-yellow-400/80"></span>
                  <span class="h-2 w-2 rounded-full bg-green-400/80"></span>
                </div>
                <Icon name={project.icon} class="h-4 w-4 text-primary" />
              </div>
              
              <!-- Image / Wireframe Area -->
              <div class="relative flex-1 overflow-hidden bg-secondary-container/10">
                {project.images && project.images.length > 0 ? (
                  <div class="grid h-full grid-cols-2 gap-1.5 p-1.5">
                    {project.images.map((img, imgIndex) =>
                      img ? (
                        <button
                          type="button"
                          class={`preview-photo group/photo relative cursor-pointer overflow-hidden rounded-lg border border-outline-variant/20 bg-surface-container-lowest focus:outline-none ${project.images.length === 1 ? "col-span-2" : ""}`}
                          data-img-src={typeof img === "string" ? img : img.src}
                          aria-label={`Preview ${project.title} photo ${imgIndex + 1}`}
                        >
                          {typeof img === "string" ? (
                            <img
                              src={img}
                              alt={`${project.title} photo ${imgIndex + 1}`}
                              class="h-full w-full object-cover object-top transition-transform duration-500 group-hover/photo:scale-105"
                              loading="lazy"
                            />
                          ) : (
                            <Image
                              src={img}
                              alt={`${project.title} photo ${imgIndex + 1}`}
                              class="h-full w-full object-cover object-top transition-transform duration-500 group-hover/photo:scale-105"
                              loading="lazy"
                            />
                          )}
                          <span class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 transition-opacity duration-300 group-hover/photo:opacity-100">
                            <span class="rounded-full bg-white/95 p-2 text-primary shadow-lg">
                              <Icon name="mdi:magnify" class="h-4 w-4" />
                            </span>
                          </span>
                        </button>
                      ) : (
                        <div class="flex min-h-0 flex-col gap-1.5 rounded-lg border border-dashed border-outline-variant/40 bg-secondary-container/10 p-2">
                          <div class="h-8 rounded-md bg-primary/10"></div>
                          <div class="grid grid-cols-2 gap-1">
                            <div class="h-6 rounded bg-white/70"></div>
                            <div class="h-6 rounded bg-white/70"></div>
                          </div>
                          <div class="mt-auto h-2 w-3/4 rounded-full bg-outline-variant/20"></div>
                          <span class="text-[9px] font-black uppercase tracking-wider text-on-surface-variant/50">Photo {imgIndex + 1}</span>
                        </div>
                      ),
                    )}
                  </div>
                ) : project.image ? (
                  <div class="relative w-full h-full">
                    <Image 
                      src={project.image} 
                      alt={`${project.title} screenshot`}
                      class="absolute inset-x-0 bottom-0 top-3 w-full h-[calc(100%-12px)] object-cover object-[center_9%] transition-transform duration-500 group-hover/img:scale-105"
                    />
                    <div class="absolute inset-x-0 bottom-0 top-3 bg-black/40 opacity-0 group-hover/img:opacity-100 flex items-center justify-center transition-opacity duration-300">
                      <div class="bg-white/95 text-primary p-2.5 rounded-full shadow-lg transform translate-y-3 group-hover/img:translate-y-0 transition-all duration-300">
                        <Icon name="mdi:magnify" class="h-5 w-5" />
                      </div>
                    </div>
                  </div>
                ) : (
                  <div class="p-4 space-y-3">
                    <div class="h-14 rounded-xl bg-primary/10"></div>
                    <div class="grid grid-cols-2 gap-2">
                      <div class="h-10 rounded-lg bg-white/70"></div>
                      <div class="h-10 rounded-lg bg-white/70"></div>
                    </div>
                    <div class="h-3 w-2/3 rounded-full bg-outline-variant/20 mt-2"></div>
                  </div>
                )}
              </div>
            </div>
          </div>

          <div class="flex flex-col gap-4 border-t border-outline-variant/20 pt-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex flex-wrap gap-2">
              {project.focus.map((item) => (
                <span class="text-xs font-bold uppercase tracking-wide text-on-surface-variant/70">{item}</span>
              ))}
            </div>
            <a href={project.demoUrl || project.githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-bold text-primary transition-colors hover:text-primary-container">
              View Details
              <Icon name="mdi:arrow-top-right" class="h-4 w-4" />
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<!-- Lightbox Modal for Image Preview (Achievements Style) -->
<div
  id="project-lightbox"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4 md:p-10"
  role="dialog"
  aria-modal="true"
  aria-label="Project screenshot preview"
>
  <button
    type="button"
    id="project-lightbox-close"
    class="absolute top-4 right-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/90 text-gray-800 shadow-lg transition-transform hover:scale-110 focus:outline-none"
    aria-label="Close preview"
  >
    <Icon name="mdi:close" class="h-6 w-6" />
  </button>

  <button
    type="button"
    id="project-lightbox-prev"
    class="absolute left-3 md:left-8 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/90 text-gray-800 shadow-lg transition-transform hover:scale-110 focus:outline-none"
    aria-label="Previous image"
  >
    <Icon name="mdi:chevron-left" class="h-6 w-6" />
  </button>

  <button
    type="button"
    id="project-lightbox-next"
    class="absolute right-3 md:right-8 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/90 text-gray-800 shadow-lg transition-transform hover:scale-110 focus:outline-none"
    aria-label="Next image"
  >
    <Icon name="mdi:chevron-right" class="h-6 w-6" />
  </button>

  <figure class="flex max-h-full max-w-5xl flex-col items-center gap-4">
    <div
      id="project-lightbox-badge"
      class="hidden items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-sm font-bold text-white"
    ></div>
    <img
      id="project-lightbox-image"
      src=""
      alt=""
      class="max-h-[78vh] w-auto max-w-full rounded-2xl object-contain shadow-2xl bg-white p-2"
    />
    <figcaption
      id="project-lightbox-caption"
      class="text-center text-sm font-semibold text-white drop-shadow"
    ></figcaption>
  </figure>
</div>

<script>
  // Project Image Lightbox Navigation Logic (Achievements Style)
  const lb = document.getElementById("project-lightbox");
  const lbImg = document.getElementById("project-lightbox-image");
  const lbCaption = document.getElementById("project-lightbox-caption");
  const lbBadge = document.getElementById("project-lightbox-badge");
  const closeBtn = document.getElementById("project-lightbox-close");
  const prevBtn = document.getElementById("project-lightbox-prev");
  const nextBtn = document.getElementById("project-lightbox-next");

  const triggers = Array.from(
    document.querySelectorAll<HTMLElement>("[data-img-src]")
  );

  let activePreviews: { src: string; alt: string; title: string }[] = [];
  let current = 0;
  let lastFocused: HTMLElement | null = null;

  const render = () => {
    if (!lbImg || !lbCaption) return;
    const item = activePreviews[current];
    if (!item) return;
    lbImg.setAttribute("src", item.src);
    lbImg.setAttribute("alt", item.alt);
    lbCaption.textContent = `Photo ${current + 1} / ${activePreviews.length}`;
    if (lbBadge) {
      lbBadge.textContent = item.title;
      lbBadge.classList.remove("hidden");
      lbBadge.classList.add("inline-flex");
    }
  };

  const openLightbox = (trigger: HTMLElement) => {
    const scopedSrc = trigger.getAttribute("data-img-src");
    if (!scopedSrc) return;

    // Navigasi lintas kartu: kumpulkan semua foto dari kartu yang terlihat,
    // sehingga tombol prev/next (<> ) selalu berfungsi (juga saat satu kartu cuma 1 foto).
    // Badge di lightbox menampilkan judul kartu asal setiap foto.
    activePreviews = Array.from(
      document.querySelectorAll<HTMLElement>("[data-project-card]:not(.hidden) [data-img-src]"),
    )
      .map((t) => {
        const src = t.getAttribute("data-img-src");
        if (!src) return null;
        const card = t.closest("[data-project-card]");
        const cardTitle = card?.getAttribute("data-project-title") || "Project Preview";
        return { src, title: cardTitle, alt: `${cardTitle} · Photo` };
      })
      .filter((p): p is { src: string; title: string; alt: string } => p !== null);

    if (activePreviews.length === 0) return;
    current = Math.max(0, activePreviews.findIndex((p) => p.src === scopedSrc));
    lastFocused = document.activeElement as HTMLElement;
    render();
    lb?.classList.remove("hidden");
    lb?.classList.add("flex");
    document.body.style.overflow = "hidden";
    closeBtn?.focus();
  };

  const closeLightbox = () => {
    lb?.classList.add("hidden");
    lb?.classList.remove("flex");
    document.body.style.overflow = "";
    lastFocused?.focus();
  };

  const step = (dir: number) => {
    if (activePreviews.length === 0) return;
    current = (current + dir + activePreviews.length) % activePreviews.length;
    render();
  };

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => openLightbox(trigger));
    trigger.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        openLightbox(trigger);
      }
    });
  });

  closeBtn?.addEventListener("click", closeLightbox);
  prevBtn?.addEventListener("click", () => step(-1));
  nextBtn?.addEventListener("click", () => step(1));

  lb?.addEventListener("click", (e) => {
    if (e.target === lb) closeLightbox();
  });

  document.addEventListener("keydown", (e) => {
    if (lb && !lb.classList.contains("hidden")) {
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
    }
  });

  // Client-side Category Filtering Logic
  const filterBtns = document.querySelectorAll(".project-filter-btn");
  const projectCards = document.querySelectorAll("[data-project-card]");
  const featuredGrid = document.getElementById("featured-projects-grid");
  const supportingGrid = document.getElementById("supporting-projects-grid");
  const grids = [featuredGrid, supportingGrid].filter(
    (grid): grid is HTMLElement => grid !== null
  );
  const projSection = document.getElementById("projects");

  let currentFilter = "all";
  let filterTimer: number | undefined;

  const applyFilter = (value: string) => {
    if (currentFilter === value) return;
    currentFilter = value;
    projSection?.classList.add("proj-filtered");

    grids.forEach((grid) => grid.classList.add("proj-filtering"));
    window.clearTimeout(filterTimer);

    filterTimer = window.setTimeout(() => {
      projectCards.forEach((card) => {
        const cat = card.getAttribute("data-project-category");
        const show = value === "all" || cat?.split(/\s+/).includes(value);
        card.classList.toggle("hidden", !show);
      });

      grids.forEach((grid) => {
        const empty = grid.querySelectorAll("[data-project-card]:not(.hidden)").length === 0;
        grid.classList.toggle("hidden", empty);
        if (!empty) {
          // Force reflow so the fade-out → fade-in transition restarts cleanly
          void grid.offsetWidth;
        }
        grid.classList.remove("proj-filtering");
      });
    }, 220);
  };

  if (filterBtns.length && projectCards.length) {
    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        // Reset active state di SEMUA chip dulu, baru terapkan ke chip yang diklik,
        // sehingga hanya satu chip yang aktif dalam satu waktu (All Projects ikut balik ke default).
        filterBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        applyFilter(btn.getAttribute("data-filter") || "all");
      });
    });
  }
</script>

<style>
    /* ===== Projects — smooth reveal =====
       Two-phase: hidden after JS adds .proj-init, animates when .in-view */
    :root { --proj-ease: cubic-bezier(0.22, 1, 0.36, 1); }

    #projects.proj-init .proj-label,
    #projects.proj-init .proj-title,
    #projects.proj-init .proj-desc,
    #projects.proj-init .proj-filters,
    #projects.proj-init .proj-card { opacity: 0; }
    #projects.proj-init .proj-card { transform: translateY(20px); }

    #projects.in-view .proj-label {
        animation: projLabelIn 0.6s var(--proj-ease) 0.05s both;
    }
    #projects.in-view .proj-title {
        animation: projUp 0.7s var(--proj-ease) 0.1s both;
    }
    #projects.in-view .proj-desc {
        animation: projUp 0.7s var(--proj-ease) 0.16s both;
    }
    #projects.in-view .proj-filters {
        animation: projUp 0.6s var(--proj-ease) 0.22s both;
    }
    #projects.in-view .proj-card {
        animation: projCardIn 0.7s var(--proj-ease) both;
    }
    #projects.in-view .proj-card:nth-of-type(1) { animation-delay: 0.28s; }
    #projects.in-view .proj-card:nth-of-type(2) { animation-delay: 0.38s; }
    #projects.in-view .proj-card:nth-of-type(3) { animation-delay: 0.48s; }
    #projects.in-view .proj-card:nth-of-type(4) { animation-delay: 0.58s; }
    #projects.in-view .proj-card:nth-of-type(n + 5) { animation-delay: 0.68s; }

    @keyframes projUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes projLabelIn {
        from { opacity: 0; transform: translateY(-10px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes projCardIn {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
        #projects.proj-init .proj-label,
        #projects.proj-init .proj-title,
        #projects.proj-init .proj-desc,
        #projects.proj-init .proj-filters,
        #projects.proj-init .proj-card { opacity: 1; transform: none; }
        #projects.in-view .proj-label,
        #projects.in-view .proj-title,
        #projects.in-view .proj-desc,
        #projects.in-view .proj-filters,
        #projects.in-view .proj-card { animation: none; }
        #projects.proj-filtered .proj-card,
        #featured-projects-grid,
        #supporting-projects-grid { animation: none; transition: none; }
    }

    /* ===== Project filter chips (label + count) ===== */
    .project-filter-btn {
        --chip-accent: #0037b0;
        --chip-soft: #e6eaff;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: 1px solid var(--color-outline-variant);
        border-radius: 9999px;
        background: var(--color-surface-container-lowest);
        padding: 0.55rem 1rem 0.55rem 1.1rem;
        color: var(--color-on-surface-variant);
        font-size: 0.75rem;
        font-weight: 700;
        line-height: 1;
        cursor: pointer;
        transition:
            background-color 0.25s ease,
            color 0.25s ease,
            border-color 0.25s ease,
            box-shadow 0.25s ease;
        -webkit-tap-highlight-color: transparent;
    }
    @media (min-width: 768px) {
        .project-filter-btn { font-size: 0.875rem; }
    }

    .project-filter-btn .proj-chip-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.4rem;
        padding: 0.25rem 0.5rem;
        border-radius: 9999px;
        background: var(--chip-soft);
        color: var(--chip-accent);
        font-size: 0.65rem;
        font-weight: 800;
        line-height: 1;
        transition:
            background-color 0.25s ease,
            color 0.25s ease;
    }
    @media (min-width: 768px) {
        .project-filter-btn .proj-chip-count { font-size: 0.7rem; }
    }

    .project-filter-btn:hover {
        border-color: color-mix(in srgb, var(--chip-accent) 50%, transparent);
        background: var(--chip-soft);
        color: var(--chip-accent);
        box-shadow: 0 6px 16px -6px color-mix(in srgb, var(--chip-accent) 45%, transparent);
    }
    .dark .project-filter-btn:hover {
        background: color-mix(in srgb, var(--chip-accent) 18%, transparent);
        color: color-mix(in srgb, var(--chip-accent) 62%, white);
    }
    .project-filter-btn.active,
    .project-filter-btn.active:hover {
        border-color: color-mix(in srgb, var(--chip-accent) 55%, transparent);
        background: var(--chip-accent);
        color: #fff;
        box-shadow: 0 8px 20px -8px color-mix(in srgb, var(--chip-accent) 60%, transparent);
    }
    .project-filter-btn.active .proj-chip-count {
        background: rgba(255, 255, 255, 0.22);
        color: #fff;
    }

    /* ===== Project grid fade filter transition ===== */
    #featured-projects-grid,
    #supporting-projects-grid {
        transition: opacity 0.22s ease;
    }
    #featured-projects-grid.proj-filtering,
    #supporting-projects-grid.proj-filtering {
        opacity: 0;
    }
    #projects.proj-filtered .proj-card {
        animation: none;
        opacity: 1;
        transform: none;
    }
</style>

<script>
    const projSection = document.getElementById("projects");
    if (projSection) {
        projSection.classList.add("proj-init");
        let revealed = false;
        const reveal = () => {
            if (revealed) return;
            revealed = true;
            projSection.classList.add("in-view");
        };
        if ("IntersectionObserver" in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            reveal();
                            observer.disconnect();
                        }
                    });
                },
                { threshold: 0.08, rootMargin: "0px 0px -8% 0px" },
            );
            observer.observe(projSection);
            // Fallback: paksa tampil setelah 1s jika observer tidak fire di mobile (viewport quirks, address bar, dsb)
            setTimeout(reveal, 1000);
            // Jika sudah di viewport saat load (misal user reload di tengah halaman), reveal lebih cepat
            requestAnimationFrame(() => {
                const rect = projSection.getBoundingClientRect();
                if (rect.top < window.innerHeight * 0.92) {
                    setTimeout(reveal, 100);
                }
            });
        } else {
            reveal();
        }
    }
</script>