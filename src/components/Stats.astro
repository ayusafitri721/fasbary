---

---

<section
    id="stats"
    class="py-12 md:py-16 px-5 desktop:px-16 max-w-[1280px] mx-auto border-y border-outline-variant/30 bg-surface-container-lowest rounded-2xl my-8"
>
    <div
        class="stats-grid grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-4 divide-y md:divide-y-0 divide-outline-variant/30 text-center"
    >
        <!-- Stat Item 1 -->
        <div class="stat-item flex flex-col items-center justify-center p-4">
            <span
                class="stat-number text-5xl md:text-6xl font-black text-primary tracking-tight"
                data-target="10"
                data-suffix="+"
                >10+</span
            >
            <span
                class="stat-label text-xs md:text-sm font-bold tracking-widest text-on-surface-variant uppercase mt-3"
                >Projects Built</span
            >
        </div>

        <!-- Stat Item 2 -->
        <div class="stat-item flex flex-col items-center justify-center p-4 pt-8 md:pt-4">
            <span
                class="stat-number text-5xl md:text-6xl font-black text-primary tracking-tight"
                data-target="5"
                data-suffix="+"
                >5+</span
            >
            <span
                class="stat-label text-xs md:text-sm font-bold tracking-widest text-on-surface-variant uppercase mt-3"
                >Tech Stacks</span
            >
        </div>

        <!-- Stat Item 3 -->
        <div class="stat-item flex flex-col items-center justify-center p-4 pt-8 md:pt-4">
            <span
                class="stat-number text-5xl md:text-6xl font-black text-primary tracking-tight"
                data-target="3"
                data-suffix="+"
                >3+</span
            >
            <span
                class="stat-label text-xs md:text-sm font-bold tracking-widest text-on-surface-variant uppercase mt-3"
                >Years Learning & Building</span
            >
        </div>

        <!-- Stat Item 4 -->
        <div class="stat-item flex flex-col items-center justify-center p-4 pt-8 md:pt-4">
            <span
                class="stat-number stat-infinity text-5xl md:text-6xl font-black text-primary tracking-tight"
                >∞</span
            >
            <span
                class="stat-label text-xs md:text-sm font-bold tracking-widest text-on-surface-variant uppercase mt-3"
                >Curiosity to Learn</span
            >
        </div>
    </div>
</section>

<style>
    /* ===== Stats — smooth, no bounce ===== */
    :root { --stats-ease: cubic-bezier(0.22, 1, 0.36, 1); }
    .stat-item { position: relative; }

    /* Fix: use correct init class (was mistakenly .about-init) */
    section.stats-init .stat-number {
        opacity: 0;
        transform: translateY(10px) scale(0.96);
    }
    section.stats-init .stat-label { opacity: 0; }

    section.in-view .stat-number {
        animation: statIn 0.6s var(--stats-ease) both;
    }
    section.in-view .stat-item:nth-child(1) .stat-number { animation-delay: 0.06s; }
    section.in-view .stat-item:nth-child(2) .stat-number { animation-delay: 0.14s; }
    section.in-view .stat-item:nth-child(3) .stat-number { animation-delay: 0.22s; }
    section.in-view .stat-item:nth-child(4) .stat-number { animation-delay: 0.3s; }

    /* Infinity: entrance only, no endless pulse */
    section.in-view .stat-infinity {
        animation: statIn 0.6s var(--stats-ease) 0.3s both;
    }

    section.in-view .stat-label {
        animation: statFadeUp 0.55s var(--stats-ease) both;
    }
    section.in-view .stat-item:nth-child(1) .stat-label { animation-delay: 0.28s; }
    section.in-view .stat-item:nth-child(2) .stat-label { animation-delay: 0.36s; }
    section.in-view .stat-item:nth-child(3) .stat-label { animation-delay: 0.44s; }
    section.in-view .stat-item:nth-child(4) .stat-label { animation-delay: 0.52s; }

    @keyframes statIn {
        from { opacity: 0; transform: translateY(12px) scale(0.96); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes statFadeUp {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @media (min-width: 768px) {
        section .stat-item + .stat-item::before {
            content: "";
            position: absolute;
            left: 0; top: 10%;
            height: 80%; width: 1px;
            background: color-mix(in srgb, var(--color-outline-variant, #cac4d0) 30%, transparent);
            transform: scaleY(0);
            transform-origin: center;
        }
        section.in-view .stat-item + .stat-item::before {
            animation: dividerGrow 0.6s var(--stats-ease) 0.45s both;
        }
    }
    @keyframes dividerGrow { from { transform: scaleY(0); } to { transform: scaleY(1); } }

    @media (prefers-reduced-motion: reduce) {
        section.stats-init .stat-number,
        section.stats-init .stat-label { opacity: 1; transform: none; }
        section.in-view .stat-number,
        section.in-view .stat-label,
        section.in-view .stat-infinity,
        section.in-view .stat-item + .stat-item::before { animation: none; }
    }
</style>

<script>
    const stats = document.getElementById("stats");

    if (stats) {
        stats.classList.add("stats-init");

        const numbers = stats.querySelectorAll<HTMLElement>(".stat-number");

        const countUp = (el: HTMLElement) => {
            if (!el.dataset.target) return;
            const target = Number(el.dataset.target);
            const suffix = el.dataset.suffix || "";
            const duration = 1400;
            const start = performance.now();

            const tick = (now: number) => {
                const progress = Math.min((now - start) / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                el.textContent = `${Math.round(eased * target)}${suffix}`;
                if (progress < 1) requestAnimationFrame(tick);
            };

            requestAnimationFrame(tick);
        };

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        stats.classList.add("in-view");
                        numbers.forEach(countUp);
                        observer.disconnect();
                    }
                });
            },
            { threshold: 0.3 }
        );

        observer.observe(stats);
    }
</script>
